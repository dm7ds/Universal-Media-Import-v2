<Application
    x:Class="UMI.GUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:UMI.GUI.Converters"
    ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Themes/Default.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:StringToVisibilityConverter x:Key="InvertedStringToVisibility" Invert="True" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:HexColorToBrushConverter x:Key="HexToBrush" />
            <conv:HexColorToMutedBrushConverter x:Key="HexToMutedBrush" />
            <conv:BadgeKeyToForegroundConverter x:Key="BadgeKeyToFg" />
            <conv:BadgeKeyToBackgroundConverter x:Key="BadgeKeyToBg" />
            <conv:ThemeAccentBrushConverter x:Key="ThemeAccentBrush" />
            <conv:SequenceIndexToBrushConverter x:Key="SeqIndexToBrush" />
            <conv:ProfileColorIndexToBrushConverter x:Key="ProfileColorToBrush" />
            <conv:BytesToBitmapConverter x:Key="BytesToBitmap" />
            <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
            <conv:EnumToBoolConverter x:Key="EnumToBool" />
        </ResourceDictionary>
    </Application.Resources>

</Application>
