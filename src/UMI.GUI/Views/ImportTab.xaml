<UserControl
    x:Class="UMI.GUI.Views.ImportTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels"
    xmlns:views="clr-namespace:UMI.GUI.Views"
    xmlns:beh="clr-namespace:UMI.GUI.Behaviors"
    xmlns:controls="clr-namespace:UMI.GUI.Views.Controls"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers">

    <Grid>
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{StaticResource BrushBgSurface}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="0,0,0,1"
            Padding="20,10"
            MinHeight="{StaticResource HeaderBarMinHeight}">
            <DockPanel LastChildFill="False">

                <StackPanel
                    DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Button
                        Command="{Binding ImportViewModel.WatchCommand}"
                        ToolTip="{helpers:Localize ImportTab_WatchTooltip}"
                        Margin="0,0,10,0"
                        Visibility="{Binding ImportViewModel.IsWatching, Converter={StaticResource InvertedBoolToVisibility}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">

                            <Path
                                Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5ZM12,17C9.24,17 7,14.76 7,12C7,9.24 9.24,7 12,7C14.76,7 17,9.24 17,12C17,14.76 14.76,17 12,17ZM12,9C10.34,9 9,10.34 9,12C9,13.66 10.34,15 12,15C13.66,15 15,13.66 15,12C15,10.34 13.66,9 12,9Z"
                                Fill="{StaticResource BrushBg}"
                                Width="14"
                                Height="14"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Margin="0,0,7,0" />
                            <TextBlock
                                Text="{helpers:Localize ImportTab_SmartWatch}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{Binding ImportViewModel.WatchCommand}"
                        ToolTip="{helpers:Localize ImportTab_StopWatchTooltip}"
                        Margin="0,0,10,0"
                        Visibility="{Binding ImportViewModel.IsWatching, Converter={StaticResource BoolToVisibility}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton_Active}">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">

                            <Path
                                Data="M6,6 H18 V18 H6 Z"
                                Fill="{StaticResource BrushBg}"
                                Width="11"
                                Height="11"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Margin="0,0,7,0" />
                            <TextBlock
                                Text="{helpers:Localize ImportTab_StopWatch}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{Binding ImportViewModel.QuickImportCommand}"
                        ToolTip="{helpers:Localize ImportTab_QuickImportTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">

                            <Path
                                Data="M19,9H15V3H9V9H5L12,16L19,9ZM5,18V20H19V18H5Z"
                                Fill="{StaticResource BrushDrone}"
                                Width="14"
                                Height="14"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Margin="0,0,7,0" />
                            <TextBlock
                                Text="{helpers:Localize ImportTab_QuickImport}"
                                Foreground="{StaticResource BrushDrone}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{Binding ImportViewModel.PauseResumeAllCommand}"
                        ToolTip="{helpers:Localize ImportTab_PauseResumeTooltip}"
                        Margin="10,0,0,0"
                        Style="{StaticResource SecondaryActionButton}"
                        Visibility="{Binding ImportViewModel.HasActiveImports, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">

                            <Path
                                Data="{StaticResource GeoPause}"
                                Fill="{StaticResource BrushDrone}"
                                Width="11"
                                Height="14"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Visibility="{Binding ImportViewModel.IsAnyPaused, Converter={StaticResource InvertedBoolToVisibility}}" />

                            <Path
                                Data="{StaticResource GeoPlay}"
                                Fill="{StaticResource BrushDrone}"
                                Width="11"
                                Height="14"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Visibility="{Binding ImportViewModel.IsAnyPaused, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Text="{Binding ImportViewModel.PauseResumeAllLabel}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{Binding ImportViewModel.CancelAllCommand}"
                        ToolTip="{helpers:Localize ImportTab_CancelAllTooltip}"
                        Margin="10,0,0,0"
                        Style="{StaticResource CancelActionButton}"
                        Visibility="{Binding ImportViewModel.HasActiveImports, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">

                            <Path
                                Data="M6,6 H18 V18 H6 Z"
                                Fill="{StaticResource BrushErrorText}"
                                Width="10"
                                Height="10"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0" />
                            <TextBlock
                                Text="{helpers:Localize ImportTab_CancelAll}"
                                Foreground="{StaticResource BrushErrorText}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Content="{helpers:Localize Help_LearnMore}"
                        Command="{Binding ShowHelpCommand}"
                        CommandParameter="{helpers:Localize Help_AnchorImport}"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HelpLinkStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDauMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>

                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    DataContext="{Binding WorkbenchViewModel}">

                    <Border Style="{StaticResource WorkbenchBarSeparator}" Margin="0,0,16,0" />

                    <StackPanel
                        Orientation="Horizontal"
                        DataContext="{Binding DataContext.ImportViewModel.DateFilter, RelativeSource={RelativeSource AncestorType=UserControl}}">

                        <ToggleButton
                            x:Name="DateFilterToggle"
                            IsChecked="{Binding IsPopupOpen, Mode=TwoWay}"
                            ToolTip="{helpers:Localize ImportTab_DateFilterTooltip}"
                            Style="{StaticResource IconToggleButton}"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">

                                <Path
                                    Data="M19,3H18V1H16V3H8V1H6V3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V9H19V19M19,7H5V5H19V7Z"
                                    Fill="{StaticResource BrushDrone}"
                                    Width="14"
                                    Height="14"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center"
                                    Margin="0,0,7,0" />
                                <TextBlock
                                    Text="{helpers:Localize ImportTab_DateRange}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushDrone}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <Border
                            Visibility="{Binding HasDateFilter, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource WorkbenchPathPill}"
                            Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Text="{Binding DateFilterText}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{StaticResource BrushDrone}"
                                    VerticalAlignment="Center" />
                                <Button
                                    Command="{Binding ClearDateFilterCommand}"
                                    ToolTip="{helpers:Localize ImportTab_ClearDateFilter}"
                                    Cursor="Hand"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource CardDeleteButton}"
                                    Width="14"
                                    Height="14">
                                    <Path
                                        Data="{StaticResource GeoClose}"
                                        Fill="{StaticResource BrushTextMuted}"
                                        Width="8"
                                        Height="8"
                                        Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <controls:DateFilterPopup
                            HeaderText="{helpers:Localize ImportTab_ImportDateRange}"
                            IsPopupOpen="{Binding IsPopupOpen, Mode=TwoWay}"
                            PlacementTargetRef="{Binding ElementName=DateFilterToggle}" />

                    </StackPanel>

                </StackPanel>

            </DockPanel>
        </Border>

        <Grid Grid.Row="1">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    Text="{helpers:Localize ImportTab_Loading}"
                    Style="{StaticResource EmptyStateText}" />
            </StackPanel>

            <Border
                Style="{StaticResource ErrorPanel}"
                VerticalAlignment="Top"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <StackPanel>
                    <TextBlock
                        Text="{helpers:Localize ImportTab_ConfigError}"
                        FontSize="{StaticResource FontSizeMedium}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushErrorText}"
                        Margin="0,0,0,8" />
                    <TextBlock
                        Text="{Binding ErrorMessage}"
                        Style="{StaticResource ErrorText}" />
                </StackPanel>
            </Border>

            <ScrollViewer
                Padding="20,16"
                Visibility="{Binding IsLoading, Converter={StaticResource InvertedBoolToVisibility}}">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl
                    ItemsSource="{Binding CameraGroups}"
                    Padding="0,0,0,60"
                    beh:DragDropReorderBehavior.IsEnabled="True"
                    beh:DragDropReorderBehavior.DropCallback="{Binding DataContext.ReorderGroupsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CameraGroupViewModel}">
                            <StackPanel Margin="0,0,0,8">

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="16" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Background="Transparent"
                                        Cursor="SizeAll"
                                        Tag="DragHandle"
                                        IsHitTestVisible="True"
                                        MinHeight="30"
                                        VerticalAlignment="Center">
                                        <Canvas
                                            Width="8"
                                            Height="14"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Tag="DragHandle"
                                            IsHitTestVisible="False">
                                            <Canvas.Style>
                                                <Style TargetType="Canvas">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                            <Setter Property="Opacity" Value="{StaticResource DragGripHoverOpacity}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Canvas.Style>
                                            <Ellipse Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" Canvas.Left="0" Canvas.Top="0"    Tag="DragHandle" />
                                            <Ellipse Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" Canvas.Left="5" Canvas.Top="0"    Tag="DragHandle" />
                                            <Ellipse Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" Canvas.Left="0" Canvas.Top="5.5"  Tag="DragHandle" />
                                            <Ellipse Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" Canvas.Left="5" Canvas.Top="5.5"  Tag="DragHandle" />
                                            <Ellipse Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" Canvas.Left="0" Canvas.Top="11"   Tag="DragHandle" />
                                            <Ellipse Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" Canvas.Left="5" Canvas.Top="11"   Tag="DragHandle" />
                                        </Canvas>
                                    </Border>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Label}"
                                        Style="{StaticResource GroupHeaderText}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource GroupHeaderText}"
                                        Text="{Binding CountText}" />
                                </Grid>

                                <Border
                                    Height="1"
                                    Margin="0,0,0,10"
                                    Opacity="{StaticResource OpacityMuted}"
                                    Background="{Binding GroupColor, Converter={StaticResource HexToBrush}}" />

                                <ItemsControl
                                    ItemsSource="{Binding Cameras}"
                                    beh:CardMode.ShowAdvanced="False"
                                    beh:DragDropReorderBehavior.IsEnabled="True"
                                    beh:DragDropReorderBehavior.DropCallback="{Binding ReorderCamerasCommand}" />

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock
                Text="{helpers:Localize ImportTab_EmptyState}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                TextAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasError}" Value="False" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding Cameras.Count}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </Grid>

    </Grid>
</UserControl>
