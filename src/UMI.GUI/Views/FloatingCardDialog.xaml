<Window
    x:Class="UMI.GUI.Views.FloatingCardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels"
    xmlns:beh="clr-namespace:UMI.GUI.Behaviors"
    Title="Select Camera"
    Width="480"
    SizeToContent="Height"
    MinHeight="320"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False">

    <Border CornerRadius="{StaticResource RadiusDialog}" BorderThickness="1" Margin="16">
        <Border.Background>
            <SolidColorBrush Color="{StaticResource ColorBgSurface}" />
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="{StaticResource ColorBorder}" />
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="{StaticResource ShadowDialogBlurRadius}"
                ShadowDepth="{StaticResource ShadowDialogShadowDepth}"
                Direction="{StaticResource ShadowDialogDirection}"
                Color="{StaticResource ColorShadow}"
                Opacity="{StaticResource ShadowDialogOpacity}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="20,16,20,14"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                beh:WindowDragBehavior.IsEnabled="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource ColorHeaderGradientStart}" Offset="0" />
                        <GradientStop Color="{StaticResource ColorHeaderGradientEnd}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.75">
                        <Path
                            Data="M6,2 H14 L18,6 V20 C18,21.1 17.1,22 16,22 H6 C4.9,22 4,21.1 4,20 V4 C4,2.9 4.9,2 6,2 Z M14,2 V6 H18"
                            Fill="{StaticResource BrushTextSecondary}"
                            Stretch="Uniform" />
                    </Viewbox>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="{helpers:Localize FloatingCard_Title}"
                            FontSize="{StaticResource FontSizeLarge}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource BrushTextMuted}"
                            Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{helpers:Localize FloatingCard_WhichCamera}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFloating}" Value="True">
                                            <Setter Property="Text" Value="{helpers:Localize FloatingCard_MultipleUsed}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusBadge}"
                        Padding="9,4">
                        <Border.Style>
                            <Style TargetType="Border">

                                <Setter Property="Background" Value="{StaticResource BrushBadgeGyroBg}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFloating}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrushActionMuted}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontSize="{StaticResource FontSizeXSmall}"
                            FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{helpers:Localize FloatingCard_Unknown}" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushBadgeGyro}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFloating}" Value="True">
                                            <Setter Property="Text" Value="{helpers:Localize FloatingCard_Floating}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushAction}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Margin="20,16,20,8">

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.5">
                            <Path
                                Data="M6,2 H14 L18,6 V20 C18,21.1 17.1,22 16,22 H6 C4.9,22 4,21.1 4,20 V4 C4,2.9 4.9,2 6,2 Z"
                                Fill="{StaticResource BrushTextMuted}"
                                Stretch="Uniform" />
                        </Viewbox>

                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Text="{Binding CardLabel}"
                                FontSize="{StaticResource FontSizeBase}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock
                                FontFamily="{StaticResource FontMono}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Margin="0,2,0,0">
                                <Run Text="{Binding CardVsn, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding CardSizeDisplay, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Border
                        Margin="0,6,0,0"
                        Padding="8,5"
                        CornerRadius="{StaticResource RadiusBadge}"
                        Background="{StaticResource BrushBadgeGyroBg}"
                        Visibility="{Binding HasExifModel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Text="{helpers:Localize FloatingCard_ExifPrefix}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushBadgeGyro}" />
                            <TextBlock
                                Text="{Binding ExifModel}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardDivider}" Margin="0,12,0,8" />

                    <TextBlock
                        Text="{helpers:Localize FloatingCard_CameraLabel}"
                        FontSize="{StaticResource FontSizeCaption}"
                        FontWeight="Bold"
                        Foreground="{StaticResource BrushTextMuted}"
                        Margin="0,0,0,8"
                        Opacity="0.75" />

                    <ListBox
                        ItemsSource="{Binding Cameras}"
                        SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        BorderThickness="0"
                        Background="Transparent"
                        Margin="0,0,0,4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="ItemBorder"
                                                Padding="10,8"
                                                CornerRadius="{StaticResource RadiusGroup}"
                                                BorderThickness="1">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                                                </Border.Background>
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="{StaticResource ColorBorderSubtle}" />
                                                </Border.BorderBrush>
                                                <ContentPresenter />
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="SelectionStates">
                                                        <VisualState x:Name="Unselected" />
                                                        <VisualState x:Name="Selected" />
                                                        <VisualState x:Name="SelectedUnfocused" />
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource ColorBgCardHover}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource ColorAction}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="ItemBorder" Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource ColorActionMuted}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CameraSelectionEntry}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontSize="{StaticResource FontSizeBase}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrushTextPrimary}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{Binding CameraId}"
                                            Style="{StaticResource CameraIdText}" />

                                        <TextBlock
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Margin="0,2,0,0"
                                            Visibility="{Binding HasUsageStats, Converter={StaticResource BoolToVisibility}}">
                                            <Run Text="{Binding UsageCount, Mode=OneWay, StringFormat={}{0}×}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding LastUsedDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Border
                                        Grid.Column="1"
                                        CornerRadius="{StaticResource RadiusBadge}"
                                        Padding="7,3"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource BrushBadgeGyroBg}"
                                        Visibility="{Binding IsExifMatch, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock
                                            Text="{helpers:Localize FloatingCard_Exif}"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource BrushBadgeGyro}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource CardDivider}" />

                    <CheckBox
                        Content="{helpers:Localize FloatingCard_AlwaysUse}"
                        IsChecked="{Binding AlwaysUseThisCamera, Mode=TwoWay}"
                        Foreground="{StaticResource BrushTextSecondary}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Margin="0,4,0,4"
                        Cursor="Hand"
                        Visibility="{Binding IsFloating, Converter={StaticResource BoolToVisibility}}" />

                    <CheckBox
                        Content="{helpers:Localize FloatingCard_RegisterFloating}"
                        IsChecked="{Binding RegisterAsFloating, Mode=TwoWay}"
                        Foreground="{StaticResource BrushTextSecondary}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Margin="0,4,0,4"
                        Cursor="Hand"
                        Visibility="{Binding IsFloating, Converter={StaticResource InvertedBoolToVisibility}}" />

                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Row="2"
                Padding="20,12,20,16"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource BrushBorderSubtle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="1"
                        Command="{Binding SkipCommand}"
                        Cursor="Hand"
                        MinWidth="90"
                        Padding="14,7">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="SkipBorder"
                                                CornerRadius="{StaticResource RadiusGroup}"
                                                BorderThickness="1"
                                                Padding="{TemplateBinding Padding}">
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="{StaticResource ColorBorder}" />
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                                                </Border.Background>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SkipBorder" Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource ColorBgCardHover}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock
                            Text="{helpers:Localize FloatingCard_Skip}"
                            FontSize="{StaticResource FontSizeSmall}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextSecondary}" />
                    </Button>

                    <Button
                        Grid.Column="3"
                        Command="{Binding ImportCommand}"
                        Cursor="Hand"
                        MinWidth="110"
                        Padding="14,7">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="ImportBorder"
                                                CornerRadius="{StaticResource RadiusGroup}"
                                                Padding="{TemplateBinding Padding}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{StaticResource ColorAction}" />
                                                </Border.Background>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ImportBorder" Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource ColorActionHover}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ImportBorder" Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource ColorActionPressed}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock
                            Text="{helpers:Localize FloatingCard_Import}"
                            FontSize="{StaticResource FontSizeSmall}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}" />
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
