<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels"
    xmlns:beh="clr-namespace:UMI.GUI.Behaviors"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers">

    <DataTemplate x:Key="FeatureBubbleTemplate" DataType="{x:Type vm:FeatureBubbleViewModel}">
        <Border
            Cursor="Hand"
            Margin="0,0,5,4"
            CornerRadius="{StaticResource RadiusGroup}"
            BorderThickness="0"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True"
            ToolTip="{Binding Tooltip}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}" />
            </Border.InputBindings>
            <Border.Style>
                <Style TargetType="Border">

                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="Background" Value="{StaticResource BrushBubbleInactive}" />
                    <Setter Property="Opacity" Value="0.55" />
                    <Style.Triggers>

                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                            <Setter Property="Background" Value="{Binding BadgeKey, Converter={StaticResource BadgeKeyToBg}}" />
                            <Setter Property="Opacity" Value="1.0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Text" Value="{Binding Label}" />
                        <Setter Property="Foreground" Value="{StaticResource BrushBubbleTextInactive}" />
                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                <Setter Property="Foreground" Value="{Binding BadgeKey, Converter={StaticResource BadgeKeyToFg}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CameraViewModel}">
        <Border>

            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CameraCard}">
                    <Style.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushBgCardHover}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="{StaticResource ShadowCardBlurRadius}"
                                        ShadowDepth="{StaticResource ShadowCardShadowDepth}"
                                        Direction="{StaticResource ShadowDialogDirection}"
                                        Color="{StaticResource ColorShadow}"
                                        Opacity="{StaticResource ShadowCardOpacity}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource ColorBgCardHover}" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="20" />

                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    CornerRadius="3,0,0,3"
                    Margin="-12,-8,5,-8"
                    Width="3"
                    HorizontalAlignment="Left"
                    Opacity="{StaticResource OpacitySubtle}"
                    Background="{Binding TypeColor, Converter={StaticResource HexToBrush}}" />

                <Border
                    Grid.Column="0"
                    Background="Transparent"
                    Cursor="SizeAll"
                    Tag="DragHandle"
                    IsHitTestVisible="True"
                    Panel.ZIndex="10">
                    <Canvas
                        Width="8"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Tag="DragHandle"
                        IsHitTestVisible="False">
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                        <Setter Property="Opacity" Value="{StaticResource DragGripHoverOpacity}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>

                        <Ellipse Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" Canvas.Left="0" Canvas.Top="0"    Tag="DragHandle" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" Canvas.Left="5" Canvas.Top="0"    Tag="DragHandle" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" Canvas.Left="0" Canvas.Top="5.5"  Tag="DragHandle" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" Canvas.Left="5" Canvas.Top="5.5"  Tag="DragHandle" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" Canvas.Left="0" Canvas.Top="11"   Tag="DragHandle" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" Canvas.Left="5" Canvas.Top="11"   Tag="DragHandle" />
                    </Canvas>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Background="Transparent"
                    Cursor="Hand">
                    <StackPanel.InputBindings>
                        <MouseBinding
                            MouseAction="LeftClick"
                            Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    </StackPanel.InputBindings>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding EditName}"
                            VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CameraNameText}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox
                            Grid.Column="0"
                            Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="{StaticResource FontSizeMedium}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{StaticResource ColorBg}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="CaretBrush" Value="{StaticResource BrushTextPrimary}" />
                                    <Setter Property="SelectionBrush" Value="{StaticResource BrushDrone}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushDrone}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,2" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <ItemsControl
                            Grid.Column="1"
                            ItemsSource="{Binding StorageDevices}"
                            Margin="6,0,4,0"
                            VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse
                                        Width="{StaticResource CardConnectedDotSize}"
                                        Height="{StaticResource CardConnectedDotSize}"
                                        Margin="1,0"
                                        ToolTip="{Binding Label}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource BrushCardConnected}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ToggleButton
                            Grid.Column="2"
                            IsChecked="{Binding EditEnabled, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Margin="4,0,6,0"
                            ToolTip="{helpers:Localize CameraCard_EnableTooltip}">
                            <ToggleButton.Style>

                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchCompactStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource AncestorType=Border}}"
                                            Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <StackPanel
                            Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource AncestorType=Border}}"
                                            Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button
                                Style="{StaticResource CardEditVisibleButton}"
                                Command="{Binding StartEditCommand}"
                                ToolTip="{helpers:Localize CameraCard_EditTooltip}"
                                Margin="0,0,2,0">
                                <Path
                                    Data="{StaticResource GeoPencil}"
                                    Stroke="{StaticResource BrushTextMuted}"
                                    StrokeThickness="1.5"
                                    Fill="Transparent"
                                    Width="13"
                                    Height="13"
                                    Stretch="Uniform" />
                            </Button>

                            <Button
                                Style="{StaticResource CardEditingVisibleButton}"
                                Command="{Binding DataContext.SaveCameraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="{helpers:Localize CameraCard_SaveTooltip}"
                                Margin="0,0,2,0">
                                <Path
                                    Data="{StaticResource GeoCheckmark}"
                                    Stroke="{StaticResource BrushBadgeGps}"
                                    StrokeThickness="2"
                                    Fill="Transparent"
                                    Width="13"
                                    Height="11"
                                    Stretch="Uniform" />
                            </Button>

                            <Button
                                Style="{StaticResource CardEditingVisibleButton}"
                                Command="{Binding CancelEditCommand}"
                                ToolTip="{helpers:Localize CameraCard_CancelTooltip}"
                                Margin="0,0,2,0">
                                <Path
                                    Data="{StaticResource GeoXMark}"
                                    Stroke="{StaticResource BrushTextMuted}"
                                    StrokeThickness="1.8"
                                    Fill="Transparent"
                                    Width="10"
                                    Height="10"
                                    Stretch="Uniform" />
                            </Button>

                            <Button
                                Style="{StaticResource CardEditingDeleteButton}"
                                Command="{Binding DataContext.DeleteCameraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="{helpers:Localize CameraCard_DeleteCamTooltip}" />

                        </StackPanel>

                        <Border
                            Grid.Column="4"
                            VerticalAlignment="Top"
                            Margin="8,0,0,0"
                            Style="{StaticResource TypeBadge}"
                            Background="{Binding TypeColorMuted, Converter={StaticResource HexToMutedBrush}}">
                            <TextBlock
                                Text="{Binding TypeLabel}"
                                Style="{StaticResource TypeBadgeText}"
                                Foreground="{Binding TypeColor, Converter={StaticResource HexToBrush}}" />
                        </Border>
                    </Grid>

                    <TextBlock
                        Text="{Binding CameraId}"
                        Style="{StaticResource CameraIdText}" />

                    <StackPanel
                        Margin="0,6,0,2"
                        Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock
                            Text="{Binding PhaseLabel}"
                            FontSize="{StaticResource FontSizeSmall}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushDrone}"
                            Margin="0,0,0,2" />

                        <TextBlock
                            Text="{Binding CurrentSourceLabel}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource BrushTextMuted}"
                            Margin="0,0,0,2"
                            Visibility="{Binding CurrentSourceLabel, Converter={StaticResource StringToVisibility}}" />

                        <ProgressBar
                            Height="3"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding ProgressPercent}"
                            Margin="0,0,0,4"
                            Background="{StaticResource BrushBubbleInactive}"
                            Foreground="{StaticResource BrushDrone}" />

                        <StackPanel
                            Margin="0,3,0,4"
                            Visibility="{Binding IsRendering, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar
                                Height="2"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding RenderProgressPercent}"
                                Margin="0,0,0,2"
                                Background="{StaticResource BrushBubbleInactive}"
                                Foreground="{StaticResource BrushBadgeGyro}"
                                Opacity="0.8" />
                            <TextBlock
                                Text="{Binding RenderProgressText}"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{StaticResource BrushTextMuted}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding ProgressText}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource BrushTextSecondary}" />

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding SpeedText}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource BrushDrone}" />
                        </Grid>

                        <TextBlock
                            Text="{Binding EtaText}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource BrushTextMuted}"
                            Margin="0,1,0,0"
                            HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EtaText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>

                    <Grid
                        Margin="0,6,0,2"
                        Visibility="{Binding IsImportDone, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Path
                            Grid.Column="0"
                            Data="M5,13 L9,17 L19,7"
                            Stroke="{StaticResource BrushBadgeGps}"
                            StrokeThickness="2"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Width="14"
                            Height="12"
                            Stretch="Uniform"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0" />

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding ResultText}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource BrushBadgeGps}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Text="{Binding ResultText}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource BrushErrorText}"
                        Margin="0,6,0,2"
                        TextWrapping="Wrap"
                        Visibility="{Binding IsImportError, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock
                        Text="{Binding ResultText}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource BrushTextMuted}"
                        Margin="0,6,0,2"
                        Visibility="{Binding IsImportCancelled, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Collapsible issues area: skipped scan files + config-backup error.
                         Visible only when HasImportIssues=true. -->
                    <Expander
                        Margin="0,4,0,0"
                        IsExpanded="{Binding ImportIssuesExpanded, Mode=TwoWay}"
                        Visibility="{Binding HasImportIssues, Converter={StaticResource BoolToVisibility}}"
                        Foreground="{StaticResource BrushTextSecondary}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Text="⚠"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushBadgeGps}"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    VerticalAlignment="Center">
                                    <Run Text="{Binding ImportSkippedFiles.Count, Mode=OneWay}" />
                                    <Run Text="{helpers:Localize Import_FilesSkipped}" />
                                </TextBlock>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="20,4,0,4">
                            <TextBlock
                                Text="{Binding ImportBackupError}"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{StaticResource BrushErrorText}"
                                TextWrapping="Wrap"
                                Margin="0,0,0,4"
                                Visibility="{Binding ImportBackupError, Converter={StaticResource StringToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding ImportSkippedFiles}" MaxHeight="180">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding}"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            TextWrapping="Wrap"
                                            Margin="0,0,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource Self}}"
                                        Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsDauMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>

                        <ItemsControl
                            ItemsSource="{Binding SimpleFeatureBubbles}"
                            ItemTemplate="{StaticResource FeatureBubbleTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock
                            Text="{helpers:Localize CameraCard_NoFeatures}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource BrushNoFeatures}"
                            FontStyle="Italic"
                            VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoFeatures}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDauMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>

                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">

                        <Border Style="{StaticResource CardDivider}" />

                        <StackPanel
                            Margin="0,4,0,8"
                            Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="PhaseLabelText"
                                    Grid.Column="0"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushDrone}"
                                    VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding PhaseLabel}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Text" Value="{helpers:Localize CameraCard_Paused}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button
                                    Grid.Column="1"
                                    Command="{Binding PauseImportCommand}"
                                    ToolTip="{Binding PauseResumeLabel}"
                                    Height="28"
                                    Padding="10,0"
                                    Margin="0,0,4,0"
                                    Style="{StaticResource SecondaryActionButton}">
                                    <StackPanel Orientation="Horizontal">

                                        <Path
                                            Data="{StaticResource GeoPause}"
                                            Fill="{StaticResource BrushDrone}"
                                            Width="9"
                                            Height="12"
                                            Stretch="Uniform"
                                            VerticalAlignment="Center"
                                            Margin="0,0,5,0"
                                            Visibility="{Binding IsPaused, Converter={StaticResource InvertedBoolToVisibility}}" />

                                        <Path
                                            Data="{StaticResource GeoPlay}"
                                            Fill="{StaticResource BrushDrone}"
                                            Width="9"
                                            Height="12"
                                            Stretch="Uniform"
                                            VerticalAlignment="Center"
                                            Margin="0,0,5,0"
                                            Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Text="{Binding PauseResumeLabel}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    Command="{Binding CancelImportCommand}"
                                    ToolTip="{helpers:Localize CameraCard_CancelImport}"
                                    Height="28"
                                    Padding="10,0"
                                    Content="{helpers:Localize CameraCard_Cancel}"
                                    Style="{StaticResource CancelActionButton}" />
                            </Grid>

                            <TextBlock
                                Text="{Binding CurrentSourceLabel}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Margin="0,0,0,2"
                                Visibility="{Binding CurrentSourceLabel, Converter={StaticResource StringToVisibility}}" />

                            <TextBlock
                                Text="{Binding CurrentFile}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontFamily="{StaticResource FontMono}"
                                Foreground="{StaticResource BrushTextMuted}"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,0,0,2"
                                ToolTip="{Binding CurrentFile}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentFile}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </StackPanel>

                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding HasAdvancedFeatures}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource Self}}"
                                            Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsDauMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock
                                Text="{helpers:Localize CameraCard_Advanced}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource BrushTextSecondary}"
                                Margin="0,0,0,4" />

                            <ItemsControl
                                ItemsSource="{Binding AdvancedFeatureBubbles}"
                                ItemTemplate="{StaticResource FeatureBubbleTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource AncestorType=Border}}"
                                            Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <StackPanel.Resources>

                                <DataTemplate x:Key="FeatureToggleRowTemplate" DataType="{x:Type vm:FeatureBubbleViewModel}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                            <Ellipse
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                                        <Setter Property="Opacity" Value="0.3" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Fill" Value="{Binding BadgeKey, Converter={StaticResource BadgeKeyToFg}}" />
                                                                <Setter Property="Opacity" Value="1.0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <TextBlock
                                                Text="{Binding Label}"
                                                FontSize="{StaticResource FontSizeSmall}"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding Tooltip}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <ToggleButton
                                            Grid.Column="1"
                                            Style="{StaticResource ToggleSwitchCompactStyle}"
                                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                            IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding Tooltip}">
                                            <ToggleButton.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}" />
                                            </ToggleButton.InputBindings>
                                        </ToggleButton>

                                    </Grid>
                                </DataTemplate>

                            </StackPanel.Resources>

                            <TextBlock
                                Text="{helpers:Localize CameraCard_Features}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}"
                                Margin="0,4,0,8" />

                            <ItemsControl
                                ItemsSource="{Binding AllAvailableFeatures}"
                                ItemTemplate="{StaticResource FeatureToggleRowTemplate}" />

                            <TextBlock
                                Text="{Binding GpsHintText}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource BrushBadgeGps}"
                                FontStyle="Italic"
                                Margin="0,0,0,6"
                                TextWrapping="Wrap"
                                Visibility="{Binding ShowGpsHint, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Margin="0,6,0,4">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGyroflowAvailable}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Text="{helpers:Localize CameraCard_GyroflowPreset}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    Margin="0,0,0,4" />

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        FontFamily="{StaticResource FontMono}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding EditGyroflowPreset}"
                                        Margin="0,0,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">

                                                <Setter Property="Text" Value="{Binding EditGyroflowPreset}" />
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding HasGyroflowPreset}" Value="False">
                                                        <Setter Property="Text" Value="{helpers:Localize CameraCard_NoPreset}" />
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding BrowseGyroflowPresetCommand}"
                                        IsEnabled="{Binding IsEditing}"
                                        ToolTip="{helpers:Localize CameraCard_BrowsePresetTooltip}"
                                        Style="{StaticResource CardHeaderIconButton}"
                                        Margin="0,0,2,0">

                                        <Path
                                            Data="M2,6 C2,4.9 2.9,4 4,4 L9,4 L11,6 L20,6 C21.1,6 22,6.9 22,8 L22,18 C22,19.1 21.1,20 20,20 L4,20 C2.9,20 2,19.1 2,18 Z"
                                            Stroke="{StaticResource BrushTextSecondary}"
                                            StrokeThickness="1.5"
                                            Fill="Transparent"
                                            Width="14"
                                            Height="14"
                                            Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{StaticResource BrushTextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>

                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding ClearGyroflowPresetCommand}"
                                        IsEnabled="{Binding IsEditing}"
                                        ToolTip="{helpers:Localize CameraCard_RemovePresetTooltip}"
                                        Style="{StaticResource CardHeaderIconButton}">
                                        <Button.Visibility>
                                            <Binding Path="HasGyroflowPreset" Converter="{StaticResource BoolToVisibility}" />
                                        </Button.Visibility>

                                        <Path
                                            Data="{StaticResource GeoXMark}"
                                            Stroke="{StaticResource BrushTextMuted}"
                                            StrokeThickness="1.5"
                                            Width="10"
                                            Height="10"
                                            Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{StaticResource BrushTextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>
                                </Grid>
                            </Grid>

                            <Grid Margin="0,8,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{helpers:Localize CameraCard_CameraType}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding EditCameraType}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ComboBox
                                    Grid.Column="1"
                                    ItemsSource="{Binding AvailableCameraTypes}"
                                    SelectedItem="{Binding EditCameraType, Mode=TwoWay}">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,8,0,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Row="0" Grid.ColumnSpan="2"
                                    Text="{helpers:Localize CameraCard_FileTypes}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    Margin="0,0,0,6" />

                                <TextBlock
                                    Grid.Row="1" Grid.Column="0"
                                    Text="{helpers:Localize CameraCard_Video}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,4" />

                                <TextBlock
                                    Grid.Row="1" Grid.Column="1"
                                    Text="{Binding EditVideoExtensions}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBox
                                    Grid.Row="1" Grid.Column="1"
                                    Text="{Binding EditVideoExtensions, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsEditing}"
                                    Margin="0,0,0,4">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{StaticResource ColorBg}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="Padding" Value="4,2" />
                                            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
                                            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                            <Setter Property="CaretBrush" Value="{StaticResource BrushTextPrimary}" />
                                            <Setter Property="SelectionBrush" Value="{StaticResource BrushDrone}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushDrone}" />
                                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <TextBlock
                                    Grid.Row="2" Grid.Column="0"
                                    Text="{helpers:Localize CameraCard_Photo}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0" />

                                <TextBlock
                                    Grid.Row="2" Grid.Column="1"
                                    Text="{Binding EditPhotoExtensions}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBox
                                    Grid.Row="2" Grid.Column="1"
                                    Text="{Binding EditPhotoExtensions, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsEditing}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{StaticResource ColorBg}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="Padding" Value="4,2" />
                                            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
                                            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                            <Setter Property="CaretBrush" Value="{StaticResource BrushTextPrimary}" />
                                            <Setter Property="SelectionBrush" Value="{StaticResource BrushDrone}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushDrone}" />
                                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>

                            <Border Style="{StaticResource CardDivider}" />
                        </StackPanel>

                        <Grid Margin="0,2,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock
                                    Text="{helpers:Localize CameraCard_FolderName}"
                                    FontSize="{StaticResource FontSizeBase}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock
                                    Text="{helpers:Localize CameraCard_FolderNameHint}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    Margin="0,1,0,0" />
                            </StackPanel>

                            <TextBlock
                                Grid.Row="1"
                                Text="{Binding FolderNameDisplay}"
                                FontSize="{StaticResource FontSizeBase}"
                                FontFamily="{StaticResource FontMono}"
                                Foreground="{StaticResource BrushTextSecondary}"
                                Padding="4,4,4,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource AncestorType=Border}}"
                                                Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBox
                                Grid.Row="1"
                                ToolTip="{helpers:Localize Tooltip_FolderName}"
                                Text="{Binding EditFolderName, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">

                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{StaticResource ColorBg}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="Padding" Value="4,4,4,6" />
                                        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                        <Setter Property="CaretBrush" Value="{StaticResource BrushTextPrimary}" />
                                        <Setter Property="SelectionBrush" Value="{StaticResource BrushDrone}" />
                                        <Style.Triggers>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource AncestorType=Border}}" Value="True" />
                                                    <Condition Binding="{Binding IsEditing}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushDrone}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,2" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <TextBlock
                                Grid.Row="1"
                                IsHitTestVisible="False"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontFamily="{StaticResource FontMono}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Opacity="0.8"
                                Padding="4,4,4,6"
                                VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource AncestorType=Border}}" Value="True" />
                                                    <Condition Binding="{Binding IsEditing}" Value="True" />
                                                    <Condition Binding="{Binding EditFolderName}" Value="" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding CameraId, Mode=OneWay}" /><Run Text=" (default)" />
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0" Grid.Column="0"
                                Text="{helpers:Localize CameraCard_Storage}"
                                Style="{StaticResource GroupHeaderText}"
                                Margin="0,0,0,8" />

                            <Button
                                Grid.Row="0" Grid.Column="1"
                                Content="{helpers:Localize CameraCard_Manage}"
                                Style="{StaticResource LinkButtonStyle}"
                                Command="{Binding DataContext.ShowCardManagementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                VerticalAlignment="Center" />

                            <ItemsControl
                                Grid.Row="1" Grid.ColumnSpan="2"
                                ItemsSource="{Binding StorageDevices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StorageDeviceInfo}">

                                        <StackPanel
                                            Orientation="Vertical"
                                            Margin="0,0,16,4"
                                            HorizontalAlignment="Center">

                                            <Grid Width="24" Height="24" HorizontalAlignment="Center">

                                                <Path
                                                    Data="M6,2 L14,2 L18,6 L18,22 L6,22 Z M14,2 L14,6 L18,6 M8,11 L8,9 M11,11 L11,9 M14,11 L14,9"
                                                    Stretch="Uniform"
                                                    Width="18" Height="22"
                                                    StrokeThickness="1.5"
                                                    StrokeLineJoin="Round"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{StaticResource BrushTextSecondary}" />
                                                            <Setter Property="Fill" Value="Transparent" />
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static vm:StorageDeviceType.SdCard}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>

                                                <Path
                                                    Data="M12,2 L12,14 M12,14 L8,10 M12,14 L16,10 M8,16 C8,16 6,17 6,19 C6,21 7,22 9,22 C11,22 12,21 12,19 L12,14 M16,16 C17,16 18,17 18,19 C18,20 17,21 16,21 L13,21"
                                                    Stretch="Uniform"
                                                    Width="16" Height="22"
                                                    StrokeThickness="1.5"
                                                    StrokeLineJoin="Round"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{StaticResource BrushTextSecondary}" />
                                                            <Setter Property="Fill" Value="Transparent" />
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static vm:StorageDeviceType.Mtp}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>

                                                <Path
                                                    Data="M2,6 L2,20 L22,20 L22,8 L12,8 L10,6 Z"
                                                    Stretch="Uniform"
                                                    Width="20" Height="18"
                                                    StrokeThickness="1.5"
                                                    StrokeLineJoin="Round"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{StaticResource BrushTextSecondary}" />
                                                            <Setter Property="Fill" Value="Transparent" />
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static vm:StorageDeviceType.FixedPath}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>

                                            <Ellipse
                                                Width="{StaticResource CardConnectedDotSize}"
                                                Height="{StaticResource CardConnectedDotSize}"
                                                HorizontalAlignment="Center"
                                                Margin="0,4,0,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">

                                                        <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                                        <Setter Property="Opacity" Value="0.35" />
                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource BrushCardConnected}" />
                                                                <Setter Property="Opacity" Value="1.0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <TextBlock
                                                Text="{Binding Label}"
                                                FontSize="{StaticResource FontSizeSmall}"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                TextAlignment="Center"
                                                MaxWidth="100"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Label}"
                                                Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Grid.Row="1" Grid.ColumnSpan="2"
                                Text="{helpers:Localize CameraCard_NoStorage}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontStyle="Italic"
                                Foreground="{StaticResource BrushTextMuted}"
                                Visibility="{Binding HasNoStorageDevices, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <Border Margin="0,10,0,8">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardDivider}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource AncestorType=Border}}"
                                            Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsDauMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource AncestorType=Border}}"
                                            Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsDauMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{helpers:Localize CameraCard_FeatureHint}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontFamily="{StaticResource FontMono}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Opacity="0.65"
                                VerticalAlignment="Center" />

                            <Button
                                Grid.Column="1"
                                Content="{helpers:Localize CameraCard_EditCam}"
                                Style="{StaticResource EditCamLinkButton}"
                                ToolTip="{helpers:Localize CameraCard_EditCamTooltip}"
                                Command="{Binding DataContext.EditCameraInSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        </Grid>

                        <Border Margin="0,10,0,8">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardDivider}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource AncestorType=Border}}"
                                            Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource AncestorType=Border}}" Value="True" />
                                                <Condition Binding="{Binding IsEditing}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontFamily="{StaticResource FontMono}"
                                Text="{Binding DataContext.SaveStatusMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                Foreground="{StaticResource BrushBadgeGps}" />

                            <Button
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Content="{helpers:Localize CameraCard_Cancel}"
                                Style="{StaticResource CardNeutralButton}"
                                Command="{Binding DataContext.CancelCameraEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />

                            <Button
                                Grid.Column="2"
                                Command="{Binding DataContext.SaveCameraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CardSaveButton}">
                                        <Setter Property="Content" Value="Save" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                <Setter Property="Content" Value="Save *" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding (beh:CardMode.ShowAdvanced), RelativeSource={RelativeSource AncestorType=Border}}" Value="True" />
                                                <Condition Binding="{Binding IsEditing}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontFamily="{StaticResource FontMono}"
                                Text="{Binding DataContext.SaveStatusMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                Foreground="{StaticResource BrushBadgeGps}" />

                            <Button
                                Grid.Column="1"
                                Command="{Binding DataContext.DeleteCameraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Width="28"
                                Height="28"
                                Cursor="Hand"
                                ToolTip="{helpers:Localize CameraCard_DeleteCamTooltip}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="TrashBorder"
                                                        Width="28"
                                                        Height="28"
                                                        CornerRadius="5"
                                                        Background="Transparent">
                                                        <Path
                                                            x:Name="TrashIcon"
                                                            Data="M3,6 H21 M8,6 V4 H16 V6 M19,6 L18,20 C18,21.1 17.1,22 16,22 H8 C6.9,22 6,21.1 6,20 L5,6"
                                                            Stroke="{StaticResource BrushTextMuted}"
                                                            StrokeThickness="1.5"
                                                            Width="14"
                                                            Height="14"
                                                            Stretch="Uniform"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Fill="Transparent" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="TrashBorder" Property="Background" Value="{StaticResource BrushErrorBg}" />
                                                            <Setter TargetName="TrashIcon" Property="Stroke" Value="{StaticResource BrushErrorText}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
