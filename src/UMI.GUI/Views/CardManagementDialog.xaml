<Window
    x:Class="UMI.GUI.Views.CardManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers"
    xmlns:beh="clr-namespace:UMI.GUI.Behaviors"
    Title="Storage Devices"
    Width="480"
    Height="520"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False">

    <Border CornerRadius="{StaticResource RadiusDialog}"
            BorderThickness="1"
            Margin="16">
        <Border.Background>
            <SolidColorBrush Color="{StaticResource ColorBgSurface}" />
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="{StaticResource ColorBorder}" />
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="{StaticResource ShadowDialogBlurRadius}"
                ShadowDepth="{StaticResource ShadowDialogShadowDepth}"
                Direction="{StaticResource ShadowDialogDirection}"
                Color="{StaticResource ColorShadow}"
                Opacity="{StaticResource ShadowDialogOpacity}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>

                <RowDefinition Height="Auto" />

                <RowDefinition Height="*" />

                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="20,16,20,12"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    beh:WindowDragBehavior.IsEnabled="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Text="{helpers:Localize CardMgmt_Title}"
                            FontSize="{StaticResource FontSizeLarge}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock
                            x:Name="CameraNameText"
                            FontSize="{StaticResource FontSizeSmall}"
                            FontFamily="{StaticResource FontMono}"
                            Foreground="{StaticResource BrushTextMuted}"
                            Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Click="CloseButton_Click"
                            Style="{StaticResource DialogCloseButton}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Margin="20,16,20,8">

                    <TextBlock
                        Text="{helpers:Localize CardMgmt_SdCards}"
                        FontSize="{StaticResource FontSizeLabel}"
                        FontWeight="Bold"
                        Foreground="{StaticResource BrushTextMuted}"
                        Margin="0,0,0,8" />

                    <ItemsControl x:Name="SdCardsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="12,8"
                                    CornerRadius="{StaticResource RadiusButton}"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource BrushBorderSubtle}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Vsn}"
                                                FontSize="{StaticResource FontSizeBody}"
                                                FontFamily="{StaticResource FontMono}"
                                                Foreground="{StaticResource BrushTextPrimary}" />
                                            <TextBlock
                                                Text="{Binding Label}"
                                                FontSize="{StaticResource FontSizeLabel}"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Tag="{Binding Vsn}"
                                                Click="RemoveSdCard_Click"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CardDeleteButton}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        x:Name="NoSdCardsText"
                        Text="{helpers:Localize CardMgmt_NoSdCards}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource BrushTextMuted}"
                        FontStyle="Italic"
                        Margin="0,0,0,8"
                        Visibility="Collapsed" />

                    <Border
                        x:Name="AddSdCardPanel"
                        Margin="0,4,0,0"
                        Padding="12,8"
                        CornerRadius="{StaticResource RadiusButton}"
                        BorderThickness="1"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        Visibility="Collapsed">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource ColorBg}" />
                        </Border.Background>
                        <StackPanel>
                            <TextBlock
                                Text="{helpers:Localize CardMgmt_VolumeSerial}"
                                FontSize="{StaticResource FontSizeLabel}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Margin="0,0,0,4" />
                            <TextBox
                                x:Name="NewVsnTextBox"
                                FontSize="{StaticResource FontSizeBody}"
                                FontFamily="{StaticResource FontMono}"
                                Padding="8,6"
                                Background="Transparent"
                                Foreground="{StaticResource BrushTextPrimary}"
                                CaretBrush="{StaticResource BrushTextPrimary}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1" />

                            <TextBlock
                                Text="{helpers:Localize CardMgmt_LabelOptional}"
                                FontSize="{StaticResource FontSizeLabel}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Margin="0,8,0,4" />
                            <TextBox
                                x:Name="NewLabelTextBox"
                                FontSize="{StaticResource FontSizeBody}"
                                Padding="8,6"
                                Background="Transparent"
                                Foreground="{StaticResource BrushTextPrimary}"
                                CaretBrush="{StaticResource BrushTextPrimary}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1" />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                                <Button Content="{helpers:Localize CardMgmt_Cancel}" Click="CancelAddSdCard_Click" Margin="0,0,8,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="CancelBorder"
                                                            CornerRadius="5"
                                                            Padding="12,5"
                                                            Background="Transparent"
                                                            BorderBrush="{StaticResource BrushBorderSubtle}"
                                                            BorderThickness="1">
                                                            <ContentPresenter
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CancelBorder" Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{helpers:Localize CardMgmt_Add}" Click="ConfirmAddSdCard_Click" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="ConfirmBorder"
                                                            CornerRadius="5"
                                                            Padding="16,5">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{StaticResource ColorDrone}" />
                                                            </Border.Background>
                                                            <ContentPresenter
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ConfirmBorder" Property="Opacity" Value="0.85" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button
                        x:Name="AddSdCardButton"
                        Content="{helpers:Localize CardMgmt_AddCard}"
                        Click="AddSdCard_Click"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock
                                                x:Name="AddText"
                                                Text="{TemplateBinding Content}"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Foreground="{StaticResource BrushDrone}"
                                                Opacity="0.8" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="AddText" Property="Opacity" Value="1.0" />
                                                    <Setter TargetName="AddText" Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Border
                        Background="{StaticResource BrushBorderSubtle}"
                        Height="1"
                        Margin="0,16,0,8"
                        Opacity="0.5" />

                    <TextBlock
                        Text="{helpers:Localize CardMgmt_MtpDevices}"
                        FontSize="{StaticResource FontSizeLabel}"
                        FontWeight="Bold"
                        Foreground="{StaticResource BrushTextMuted}"
                        Margin="0,0,0,8" />

                    <ItemsControl x:Name="MtpDevicesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="12,8"
                                    CornerRadius="{StaticResource RadiusButton}"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource BrushBorderSubtle}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding SerialNumber}"
                                            FontSize="{StaticResource FontSizeBody}"
                                            FontFamily="{StaticResource FontMono}"
                                            Foreground="{StaticResource BrushTextPrimary}" />
                                        <TextBlock
                                            Text="{Binding Label}"
                                            FontSize="{StaticResource FontSizeLabel}"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        x:Name="NoMtpDevicesText"
                        Text="{helpers:Localize CardMgmt_NoMtpDevices}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource BrushTextMuted}"
                        FontStyle="Italic"
                        Visibility="Collapsed" />

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="20,12"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BrushBorderSubtle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{helpers:Localize CardMgmt_Close}" Click="CloseButton_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="CloseBtnBorder"
                                                CornerRadius="{StaticResource RadiusButton}"
                                                Padding="20,7"
                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                BorderThickness="1"
                                                Background="Transparent">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBtnBorder" Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
