<Window
    x:Class="UMI.GUI.Views.AddCameraDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels"
    xmlns:beh="clr-namespace:UMI.GUI.Behaviors"
    Title="Add Camera"
    Width="480"
    Height="560"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False">

    <Border CornerRadius="{StaticResource RadiusDialog}" BorderThickness="1" Margin="16">
        <Border.Background>
            <SolidColorBrush Color="{StaticResource ColorBgSurface}" />
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="{StaticResource ColorBorder}" />
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="{StaticResource ShadowDialogBlurRadius}"
                ShadowDepth="{StaticResource ShadowDialogShadowDepth}"
                Direction="{StaticResource ShadowDialogDirection}"
                Color="{StaticResource ColorShadow}"
                Opacity="{StaticResource ShadowDialogOpacity}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="20,16,20,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                beh:WindowDragBehavior.IsEnabled="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Text="{helpers:Localize AddCamera_Title}"
                            FontSize="{StaticResource FontSizeLarge}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock
                            Text="{helpers:Localize AddCamera_Desc}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource BrushTextMuted}"
                            Margin="0,4,0,0" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource DialogCloseButton}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Margin="20,16,20,8">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Viewbox Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="{StaticResource OpacityMuted}">
                            <Path
                                Data="M18,8 H17 V6 C17,3.24 14.76,1 12,1 C9.24,1 7,3.24 7,6 V8 H6 C4.9,8 4,8.9 4,10 V20 C4,21.1 4.9,22 6,22 H18 C19.1,22 20,21.1 20,20 V10 C20,8.9 19.1,8 18,8 Z M12,17 C10.9,17 10,16.1 10,15 C10,13.9 10.9,13 12,13 C13.1,13 14,13.9 14,15 C14,16.1 13.1,17 12,17 Z M15.1,8 H8.9 V6 C8.9,4.29 10.29,2.9 12,2.9 C13.71,2.9 15.1,4.29 15.1,6 V8 Z"
                                Fill="{StaticResource BrushTextMuted}"
                                Stretch="Uniform" />
                        </Viewbox>
                        <TextBlock
                            Text="{helpers:Localize AddCamera_Identity}"
                            FontSize="{StaticResource FontSizeLabel}"
                            FontWeight="Bold"
                            Foreground="{StaticResource BrushTextMuted}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <Border
                        Padding="12,12"
                        CornerRadius="{StaticResource RadiusGroup}"
                        BorderThickness="1"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        Margin="0,0,0,16">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                        </Border.Background>
                        <StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{helpers:Localize AddCamera_CameraId}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBox
                                        Text="{Binding CameraId, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        FontFamily="{StaticResource FontMono}"
                                        Padding="8,5"
                                        Background="{StaticResource BrushBgSurface}"
                                        Foreground="{StaticResource BrushTextPrimary}"
                                        CaretBrush="{StaticResource BrushTextPrimary}"
                                        BorderBrush="{StaticResource BrushBorderSubtle}"
                                        BorderThickness="1" />

                                    <TextBlock
                                        Text="{Binding CameraIdError}"
                                        FontSize="{StaticResource FontSizeLabel}"
                                        Foreground="{StaticResource BrushErrorText}"
                                        Margin="0,3,0,0"
                                        Visibility="{Binding CameraIdError, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{helpers:Localize AddCamera_DisplayName}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    VerticalAlignment="Center" />
                                <TextBox
                                    Grid.Column="1"
                                    Text="{Binding CameraName, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Padding="8,5"
                                    Background="{StaticResource BrushBgSurface}"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    CaretBrush="{StaticResource BrushTextPrimary}"
                                    BorderBrush="{StaticResource BrushBorderSubtle}"
                                    BorderThickness="1" />
                            </Grid>
                            <TextBlock
                                Text="{helpers:Localize AddCamera_DisplayNameHint}"
                                FontSize="{StaticResource FontSizeLabel}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Margin="90,4,0,0"
                                Opacity="{StaticResource OpacitySubtle}" />

                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Viewbox Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="{StaticResource OpacityMuted}">
                            <Path
                                Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M12,5 C13.66,5 15,6.34 15,8 C15,9.66 13.66,11 12,11 C10.34,11 9,9.66 9,8 C9,6.34 10.34,5 12,5 Z M12,19.2 C9.5,19.2 7.29,17.92 6,15.98 C6.03,13.99 10,12.9 12,12.9 C13.99,12.9 17.97,13.99 18,15.98 C16.71,17.92 14.5,19.2 12,19.2 Z"
                                Fill="{StaticResource BrushTextMuted}"
                                Stretch="Uniform" />
                        </Viewbox>
                        <TextBlock
                            Text="{helpers:Localize AddCamera_Profile}"
                            FontSize="{StaticResource FontSizeLabel}"
                            FontWeight="Bold"
                            Foreground="{StaticResource BrushTextMuted}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <ComboBox
                        ItemsSource="{Binding AvailableProfiles}"
                        SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                        Style="{StaticResource DarkComboBoxStyle}"
                        Margin="0,0,0,6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CameraProfileItem}">
                                <StackPanel Orientation="Horizontal" Margin="2,2">

                                    <Border
                                        Width="3"
                                        CornerRadius="2"
                                        Margin="0,0,8,0"
                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />

                                    <TextBlock
                                        Text="{Binding TypeName}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock
                        Text="{Binding SelectedProfileDescription}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource BrushTextMuted}"
                        FontStyle="Italic"
                        Margin="0,0,0,4"
                        TextWrapping="Wrap"
                        Opacity="0.8" />

                    <TextBlock
                        Text="{helpers:Localize AddCamera_NoProfiles}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource BrushTextMuted}"
                        FontStyle="Italic"
                        Margin="4,0,0,8"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvailableProfiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel
                        Margin="0,8,0,0"
                        Visibility="{Binding HasDetectedDrives, Converter={StaticResource BoolToVisibility}}">

                        <Border Style="{StaticResource CardDivider}" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Viewbox Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="{StaticResource OpacityMuted}">
                                <Path
                                    Data="M4,4 C4,2.9 4.9,2 6,2 H14 L20,8 V20 C20,21.1 19.1,22 18,22 H6 C4.9,22 4,21.1 4,20 V4 Z M14,2 V8 H20"
                                    Fill="{StaticResource BrushTextMuted}"
                                    Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock
                                Text="{helpers:Localize AddCamera_AssignSdCard}"
                                FontSize="{StaticResource FontSizeLabel}"
                                FontWeight="Bold"
                                Foreground="{StaticResource BrushTextMuted}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Text="{helpers:Localize AddCamera_AssignHint}"
                                FontSize="{StaticResource FontSizeLabel}"
                                Foreground="{StaticResource BrushTextMuted}"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                FontStyle="Italic"
                                Opacity="{StaticResource OpacityHint}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding DetectedUnregisteredDrives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NewCameraDriveItem}">
                                    <Border
                                        Margin="0,0,0,5"
                                        Padding="10,8"
                                        CornerRadius="{StaticResource RadiusButton}"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource BrushBorderSubtle}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                Grid.Column="0"
                                                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"
                                                Foreground="{StaticResource BrushTextPrimary}" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding DisplayName}"
                                                    FontSize="{StaticResource FontSizeSmall}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock
                                                    Text="{Binding SubInfo}"
                                                    FontSize="{StaticResource FontSizeCaption}"
                                                    FontFamily="{StaticResource FontMono}"
                                                    Foreground="{StaticResource BrushTextMuted}"
                                                    Margin="0,2,0,0" />
                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Row="2"
                Padding="20,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource BrushBorderSubtle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding StatusMessage}"
                        FontSize="{StaticResource FontSizeCaption}"
                        FontFamily="{StaticResource FontMono}"
                        Foreground="{StaticResource BrushBadgeGps}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

                    <Button
                        Grid.Column="1"
                        Command="{Binding CloseCommand}"
                        Margin="0,0,8,0"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="CloseBtnBorder"
                                                CornerRadius="{StaticResource RadiusButton}"
                                                Padding="16,7"
                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                BorderThickness="1"
                                                Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBtnBorder" Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Content" Value="{helpers:Localize AddCamera_Close}" />
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Command="{Binding AddCommand}"
                        IsEnabled="{Binding CanAdd}"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EditCamLinkButton}">
                                <Setter Property="Padding" Value="16,7" />
                            </Style>
                        </Button.Style>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Data="M12,4 V20 M4,12 H20"
                                    Stroke="{StaticResource BrushDrone}"
                                    StrokeThickness="2"
                                    Width="11"
                                    Height="11"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    Opacity="{StaticResource OpacityHover}" />
                                <TextBlock
                                    Text="{helpers:Localize AddCamera_AddCamera}"
                                    FontSize="{StaticResource FontSizeBody}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushDrone}"
                                    Opacity="{StaticResource OpacityHover}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
