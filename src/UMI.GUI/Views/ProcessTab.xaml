<UserControl
    x:Class="UMI.GUI.Views.ProcessTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels"
    xmlns:controls="clr-namespace:UMI.GUI.Views.Controls">

    <UserControl.Resources>

        <!-- Shared action card template — used by all three group tabs (DRY!) -->
        <DataTemplate x:Key="ProcessActionCardTemplate" DataType="{x:Type vm:ProcessActionViewModel}">

            <Border Style="{StaticResource ProcessActionCard}">
                <StackPanel>

                    <DockPanel LastChildFill="False" Margin="0,0,0,8">

                        <StackPanel
                            DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <Border
                                Width="32"
                                Height="32"
                                CornerRadius="{StaticResource RadiusGroup}"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource ColorDrone}" Opacity="0.12" />
                                </Border.Background>
                                <Path
                                    Data="{Binding IconPathData}"
                                    Fill="{StaticResource BrushDrone}"
                                    Width="16"
                                    Height="16"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <TextBlock
                                Text="{Binding Title}"
                                FontSize="{StaticResource FontSizeBase}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextPrimary}"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel
                            DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <Button
                                Command="{Binding RunCommand}"
                                ToolTip="{helpers:Localize ProcessTab_RunTooltip}"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsRunning, Converter={StaticResource InvertedBoolToVisibility}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">

                                    <Path
                                        Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                        Fill="{StaticResource BrushBg}"
                                        Width="12"
                                        Height="12"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0" />
                                    <TextBlock
                                        Text="{helpers:Localize ProcessTab_Run}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button
                                Command="{Binding CancelCommand}"
                                ToolTip="{helpers:Localize ProcessTab_CancelTooltip}"
                                Style="{StaticResource CancelActionButton}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">

                                    <Path
                                        Data="M6,6 H18 V18 H6 Z"
                                        Fill="{StaticResource BrushErrorText}"
                                        Width="10"
                                        Height="10"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0" />
                                    <TextBlock
                                        Text="{helpers:Localize ProcessTab_Cancel}"
                                        Foreground="{StaticResource BrushErrorText}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </DockPanel>

                    <TextBlock
                        Text="{Binding Description}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource BrushTextSecondary}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,10" />

                    <ItemsControl
                        ItemsSource="{Binding Toggles}"
                        Visibility="{Binding HasToggles, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                        Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Margin="0,0,0,6"
                                    ToolTip="{Binding Tooltip}">
                                    <ToggleButton
                                        Style="{StaticResource ToggleSwitchCompactStyle}"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{Binding Label}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Foreground="{StaticResource BrushTextSecondary}"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,4">

                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="{Binding ProgressText}"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{StaticResource BrushTextMuted}"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0" />
                            <ProgressBar
                                Value="{Binding Progress, Mode=OneWay}"
                                Maximum="1"
                                Style="{StaticResource ProcessProgressBar}"
                                VerticalAlignment="Center" />
                        </DockPanel>

                        <StackPanel
                            Margin="0,4,0,0"
                            Visibility="{Binding IsRendering, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Text="{Binding RenderProgressText}"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{StaticResource BrushTextMuted}"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,0,0,3" />
                            <ProgressBar
                                Value="{Binding RenderProgress, Mode=OneWay}"
                                Maximum="1"
                                Style="{StaticResource ProcessProgressBar}"
                                Opacity="{StaticResource OpacitySubtle}" />
                        </StackPanel>

                        <TextBlock
                            Text="{Binding CurrentFile}"
                            FontSize="{StaticResource FontSizeCaption}"
                            FontFamily="{StaticResource FontMono}"
                            Foreground="{StaticResource BrushTextMuted}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding IsRendering, Converter={StaticResource InvertedBoolToVisibility}}" />

                    </StackPanel>

                    <TextBlock
                        Text="{Binding StatusMessage}"
                        FontSize="{StaticResource FontSizeSmall}"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">

                                <Setter Property="Foreground" Value="{StaticResource BrushBadgeGps}" />
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrushErrorText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button
                        Command="{Binding ToggleResultsCommand}"
                        Style="{StaticResource ToggleDetailsButton}"
                        Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}" />

                    <ScrollViewer
                        MaxHeight="300"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Margin="0,6,0,0"
                        Visibility="{Binding IsResultsVisible, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding ResultItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">

                                        <TextBlock
                                            DockPanel.Dock="Right"
                                            Text="{Binding Status}"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock
                                            TextTrimming="CharacterEllipsis"
                                            FontSize="{StaticResource FontSizeCaption}">
                                            <Run Text="{Binding Prefix, Mode=OneTime}" Foreground="{StaticResource BrushTextMuted}" />
                                            <Run Text="{Binding FileName, Mode=OneTime}" FontFamily="{StaticResource FontMono}" />
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button
                        Command="{Binding ToggleResultsCommand}"
                        Style="{StaticResource ToggleDetailsButton}"
                        Visibility="{Binding IsStatisticsAction, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding HasStatisticsRows}" />

                    <StackPanel
                        Visibility="{Binding IsStatisticsAction, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel
                        Margin="0,6,0,0"
                        Visibility="{Binding IsResultsVisible, Converter={StaticResource BoolToVisibility}}">

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="55" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:Localize ProcessTab_DateHeader}"
                                FontSize="{StaticResource FontSizeCaption}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{helpers:Localize ProcessTab_SourceHeader}"
                                FontSize="{StaticResource FontSizeCaption}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Grid.Column="2" Text="{helpers:Localize ProcessTab_FileHeader}"
                                FontSize="{StaticResource FontSizeCaption}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Grid.Column="3" Text="{helpers:Localize ProcessTab_StatusHeader}"
                                FontSize="{StaticResource FontSizeCaption}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Grid.Column="4" Text="{helpers:Localize ProcessTab_EisHeader}"
                                FontSize="{StaticResource FontSizeCaption}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Grid.Column="5" Text="{helpers:Localize ProcessTab_GpsHeader}"
                                FontSize="{StaticResource FontSizeCaption}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Grid.Column="6" Text="{helpers:Localize ProcessTab_BackupHeader}"
                                FontSize="{StaticResource FontSizeCaption}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Grid.Column="7" Text="{helpers:Localize ProcessTab_IntegrityHeader}"
                                FontSize="{StaticResource FontSizeCaption}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}" />
                        </Grid>

                        <Border
                            Height="1"
                            Background="{StaticResource BrushBorderSubtle}"
                            Margin="0,0,0,4" />

                        <ListBox
                            MaxHeight="400"
                            ItemsSource="{Binding StatisticsRows}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Background="Transparent"
                            BorderThickness="0"
                            IsHitTestVisible="True"
                            Focusable="False"
                            SelectionMode="Single">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="55" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="35" />
                                                <ColumnDefinition Width="35" />
                                                <ColumnDefinition Width="55" />
                                                <ColumnDefinition Width="55" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Date}"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Source}"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Foreground="{StaticResource BrushTextSecondary}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding FileName}"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                FontFamily="{StaticResource FontMono}"
                                                Foreground="{StaticResource BrushTextPrimary}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Status}"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushErrorText}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="4" Text="{Binding Eis}"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Grid.Column="5" Text="{Binding Gps}"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Grid.Column="6" Text="{Binding Backup}"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="7" Text="{Binding Integrity}"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>

        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{StaticResource BrushBgSurface}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="0,0,0,1"
            Padding="20,10"
            MinHeight="{StaticResource HeaderBarMinHeight}">
            <DockPanel LastChildFill="False">

                <StackPanel
                    DockPanel.Dock="Left"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">

                        <Path
                            Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                            Fill="{StaticResource BrushDrone}"
                            Width="16"
                            Height="16"
                            Stretch="Uniform"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Opacity="{StaticResource OpacityHover}" />
                        <TextBlock
                            Text="{helpers:Localize ProcessTab_Title}"
                            FontSize="{StaticResource FontSizeBase}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <Button
                        Style="{StaticResource HelpLinkStyle}"
                        Content="{helpers:Localize Help_LearnMore}"
                        Command="{Binding DataContext.ShowHelpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding HelpAnchor}"
                        Margin="26,3,0,0" />
                </StackPanel>

                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                    <StackPanel
                        Orientation="Horizontal"
                        DataContext="{Binding DateFilter}">

                        <ToggleButton
                            x:Name="ProcessDateFilterToggle"
                            IsChecked="{Binding IsPopupOpen, Mode=TwoWay}"
                            ToolTip="{helpers:Localize ProcessTab_DateRangeTooltip}"
                            Style="{StaticResource IconToggleButton}"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Data="M19,3H18V1H16V3H8V1H6V3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V9H19V19M19,7H5V5H19V7Z"
                                    Fill="{StaticResource BrushDrone}"
                                    Width="14" Height="14"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center"
                                    Margin="0,0,7,0" />
                                <TextBlock
                                    Text="{helpers:Localize ProcessTab_DateRange}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushDrone}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <Border
                            Visibility="{Binding HasDateFilter, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource WorkbenchPathPill}"
                            Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Text="{Binding DateFilterText}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{StaticResource BrushDrone}"
                                    VerticalAlignment="Center" />
                                <Button
                                    Command="{Binding ClearDateFilterCommand}"
                                    ToolTip="{helpers:Localize ProcessTab_ClearDateFilter}"
                                    Cursor="Hand" Margin="6,0,0,0"
                                    Style="{StaticResource CardDeleteButton}"
                                    Width="14" Height="14">
                                    <Path
                                        Data="{StaticResource GeoClose}"
                                        Fill="{StaticResource BrushTextMuted}"
                                        Width="8" Height="8" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <controls:DateFilterPopup
                            HeaderText="{helpers:Localize ProcessTab_ProcessDateRange}"
                            IsPopupOpen="{Binding IsPopupOpen, Mode=TwoWay}"
                            PlacementTargetRef="{Binding ElementName=ProcessDateFilterToggle}" />

                    </StackPanel>

                </StackPanel>

            </DockPanel>
        </Border>

        <TabControl
            Grid.Row="1"
            SelectedIndex="{Binding SelectedGroupTabIndex}"
            Style="{StaticResource DarkTabControlStyle}">

            <TabItem Header="{helpers:Localize ProcessTab_GroupVideo}" Style="{StaticResource DarkTabItemStyle}">
                <ScrollViewer Padding="20,16">
                    <ItemsControl
                        ItemsSource="{Binding VideoActions}"
                        ItemTemplate="{StaticResource ProcessActionCardTemplate}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{helpers:Localize ProcessTab_GroupPhoto}" Style="{StaticResource DarkTabItemStyle}">
                <ScrollViewer Padding="20,16">
                    <ItemsControl
                        ItemsSource="{Binding PhotoActions}"
                        ItemTemplate="{StaticResource ProcessActionCardTemplate}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{helpers:Localize ProcessTab_GroupTools}" Style="{StaticResource DarkTabItemStyle}">
                <ScrollViewer Padding="20,16">
                    <ItemsControl
                        ItemsSource="{Binding ToolActions}"
                        ItemTemplate="{StaticResource ProcessActionCardTemplate}" />
                </ScrollViewer>
            </TabItem>

        </TabControl>

    </Grid>
</UserControl>
