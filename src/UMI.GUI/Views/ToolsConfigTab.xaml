<UserControl
    x:Class="UMI.GUI.Views.ToolsConfigTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels"
    xmlns:controls="clr-namespace:UMI.GUI.Views.Controls">

    <ScrollViewer Padding="24,20,24,20">
        <StackPanel>

            <StackPanel Margin="0,0,0,20">
                <TextBlock
                    Text="{helpers:Localize ToolsConfig_ExternalTools}"
                    FontSize="{StaticResource FontSizeMedium}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrushTextPrimary}" />
                <TextBlock
                    Text="{helpers:Localize ToolsConfig_ExternalToolsDesc}"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushTextMuted}"
                    Margin="0,4,0,0"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ToolRowCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExifToolIsEmpty}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushErrorBorder}" />
                                <Setter Property="Background" Value="{StaticResource BrushErrorBg}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{helpers:Localize ToolsConfig_ExifTool}" FontSize="{StaticResource FontSizeBase}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                            <Border Style="{StaticResource ToolRequiredBadge}" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{helpers:Localize ToolsConfig_Required}" Style="{StaticResource ToolRequiredBadgeText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{helpers:Localize ToolsConfig_ExifReadWrite}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <Border Grid.Column="1">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ToolPathDisplay}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExifToolIsEmpty}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushErrorBorder}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                    <Setter Property="Text" Value="{Binding ExifToolPath}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExifToolIsEmpty}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushErrorText}" />
                                            <Setter Property="Text" Value="{helpers:Localize ToolsConfig_NotConfiguredRequired}" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExifToolStatus}" Value="NotFound">
                                            <Setter Property="Foreground" Value="{StaticResource BrushErrorText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Button
                        Grid.Column="2"
                        Command="{Binding ResetExifToolDefaultCommand}"
                        Style="{StaticResource ToolBrowseButton}"
                        Content="{helpers:Localize ToolsConfig_Default}"
                        Margin="8,0,0,0"
                        ToolTip="{helpers:Localize ToolsConfig_ResetExifToolTooltip}" />

                    <Button Grid.Column="3" Command="{Binding BrowseExifToolCommand}" Style="{StaticResource ToolBrowseButton}" Margin="8,0,8,0" Content="{helpers:Localize ToolsConfig_Browse}" />

                    <controls:ToolStatusIcon
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        IsValid="{Binding ExifToolIsValid}"
                        IsEmpty="{Binding ExifToolIsEmpty}"
                        Status="{Binding ExifToolStatus}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ToolRowCard}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{helpers:Localize ToolsConfig_Gyroflow}" FontSize="{StaticResource FontSizeBase}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                            <Border Style="{StaticResource ToolOptionalBadge}" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{helpers:Localize ToolsConfig_Optional}" Style="{StaticResource ToolOptionalBadgeText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{helpers:Localize ToolsConfig_VideoStabilization}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource ToolPathDisplay}">
                        <TextBlock FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                    <Setter Property="Text" Value="{Binding GyroflowPath}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GyroflowStatus}" Value="OptionalEmpty">
                                            <Setter Property="Text" Value="{helpers:Localize ToolsConfig_NotConfigured}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GyroflowStatus}" Value="NotFound">
                                            <Setter Property="Foreground" Value="{StaticResource BrushErrorText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Button
                        Grid.Column="2"
                        Command="{Binding DownloadGyroflowCommand}"
                        Style="{StaticResource ToolBrowseButton}"
                        Content="{helpers:Localize ToolsConfig_Install}"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"
                        ToolTip="{helpers:Localize ToolsConfig_DownloadGyroflowTooltip}" />

                    <Button Grid.Column="3" Command="{Binding BrowseGyroflowCommand}" Style="{StaticResource ToolBrowseButton}" Margin="8,0,8,0" Content="{helpers:Localize ToolsConfig_Browse}" />

                    <controls:ToolStatusIcon
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        IsValid="{Binding GyroflowIsValid}"
                        Status="{Binding GyroflowStatus}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ToolRowCard}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{helpers:Localize ToolsConfig_FFprobe}" FontSize="{StaticResource FontSizeBase}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                            <Border Style="{StaticResource ToolOptionalBadge}" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{helpers:Localize ToolsConfig_Optional}" Style="{StaticResource ToolOptionalBadgeText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{helpers:Localize ToolsConfig_MediaProbe}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource ToolPathDisplay}">
                        <TextBlock FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                    <Setter Property="Text" Value="{Binding FFprobePath}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FFprobeStatus}" Value="OptionalEmpty">
                                            <Setter Property="Text" Value="{helpers:Localize ToolsConfig_NotConfigured}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FFprobeStatus}" Value="NotFound">
                                            <Setter Property="Foreground" Value="{StaticResource BrushErrorText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Button
                        Grid.Column="2"
                        Command="{Binding DownloadFFprobeCommand}"
                        Style="{StaticResource ToolBrowseButton}"
                        Content="{helpers:Localize ToolsConfig_Install}"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"
                        ToolTip="{helpers:Localize ToolsConfig_DownloadFFprobeTooltip}" />

                    <Button Grid.Column="3" Command="{Binding BrowseFFprobeCommand}" Style="{StaticResource ToolBrowseButton}" Margin="8,0,8,0" Content="{helpers:Localize ToolsConfig_Browse}" />

                    <controls:ToolStatusIcon
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        IsValid="{Binding FFprobeIsValid}"
                        Status="{Binding FFprobeStatus}" />
                </Grid>
            </Border>

            <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                <TextBlock
                    Text="{Binding DownloadStatusMessage}"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushTextSecondary}"
                    Margin="0,0,0,4" />
                <ProgressBar
                    Value="{Binding DownloadProgress, Mode=OneWay}"
                    Maximum="100"
                    Height="4"
                    Foreground="{StaticResource BrushAction}"
                    Background="{StaticResource BrushBorderSubtle}" />
            </StackPanel>

            <Border Style="{StaticResource CardDivider}" Margin="0,16,0,16" />

            <StackPanel Margin="0,0,0,16">
                <TextBlock
                    Text="{helpers:Localize ToolsConfig_Options}"
                    FontSize="{StaticResource FontSizeMedium}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrushTextPrimary}" />
                <TextBlock
                    Text="{helpers:Localize ToolsConfig_OptionsDesc}"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushTextMuted}"
                    Margin="0,4,0,0"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource ToolRowCard}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{helpers:Localize ToolsConfig_GpsTracks}" FontSize="{StaticResource FontSizeBase}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                            <Border Style="{StaticResource ToolOptionalBadge}" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{helpers:Localize ToolsConfig_Optional}" Style="{StaticResource ToolOptionalBadgeText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{helpers:Localize ToolsConfig_GpxSourceFolder}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource ToolPathDisplay}">
                        <TextBlock FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                    <Setter Property="Text" Value="{Binding GpsTrackFolder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GpsTrackFolder}" Value="">
                                            <Setter Property="Text" Value="{helpers:Localize ToolsConfig_NotConfigured}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Button Grid.Column="2" Command="{Binding BrowseGpsTrackFolderCommand}" Style="{StaticResource ToolBrowseButton}" Margin="8,0,8,0" Content="{helpers:Localize ToolsConfig_Browse}" />

                    <controls:ToolStatusIcon
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        IsValid="{Binding GpsTrackFolderExists}"
                        ShowErrorIcon="False" />
                </Grid>
            </Border>

            <Border Style="{StaticResource ToolRowCard}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock
                            Text="{helpers:Localize ToolsConfig_LogLevel}"
                            FontSize="{StaticResource FontSizeBase}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}"
                            Margin="0,0,0,2" />
                        <TextBlock
                            Text="{helpers:Localize ToolsConfig_LogLevelDesc}"
                            FontSize="{StaticResource FontSizeCaption}"
                            Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <ComboBox
                            ItemsSource="{Binding AvailableLogLevels}"
                            SelectedValue="{Binding LogLevel, Mode=TwoWay}"
                            SelectedValuePath="Code"
                            DisplayMemberPath="DisplayName"
                            MinWidth="140"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource ToolRowCard}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock
                            Text="{helpers:Localize ToolsConfig_Language}"
                            FontSize="{StaticResource FontSizeBase}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}"
                            Margin="0,0,0,2" />
                        <TextBlock
                            Text="{helpers:Localize ToolsConfig_LanguageDesc}"
                            FontSize="{StaticResource FontSizeCaption}"
                            Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <ComboBox
                            Width="160"
                            ItemsSource="{x:Static vm:ToolsViewModel.AvailableLanguages}"
                            SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                            SelectedValuePath="Code"
                            DisplayMemberPath="DisplayName"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{helpers:Localize ToolsConfig_RestartRequired}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource BrushTextMuted}"
                            FontStyle="Italic"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Visibility="{Binding ShowRestartHint, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Margin="0,8,0,0"
                Padding="12,6"
                CornerRadius="{StaticResource RadiusButton}"
                Visibility="{Binding SaveMessage, Converter={StaticResource StringToVisibility}}">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource ColorBadgeGpsBg}" />
                </Border.Background>
                <TextBlock
                    Text="{Binding SaveMessage}"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushBadgeGps}"
                    FontFamily="{StaticResource FontMono}" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
