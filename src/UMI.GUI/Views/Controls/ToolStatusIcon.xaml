<UserControl
    x:Class="UMI.GUI.Views.Controls.ToolStatusIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UMI.GUI.Views.Controls"
    Width="16"
    Height="16">

    <Grid Width="16" Height="16" VerticalAlignment="Center">

        <Path
            Data="{StaticResource GeoCheckmarkFilled}"
            Stretch="Uniform"
            Width="16"
            Height="16">
            <Path.Style>
                <Style TargetType="Path">
                    <Setter Property="Fill" Value="{StaticResource BrushBadgeGps}" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:ToolStatusIcon}, Path=IsValid}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Path.Style>
        </Path>

        <Path
            Data="{StaticResource GeoClose}"
            Stretch="Uniform"
            Width="16"
            Height="16">
            <Path.Style>
                <Style TargetType="Path">
                    <Setter Property="Fill" Value="{StaticResource BrushErrorText}" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=local:ToolStatusIcon}, Path=IsEmpty}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=local:ToolStatusIcon}, Path=ShowErrorIcon}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=local:ToolStatusIcon}, Path=Status}" Value="NotFound" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=local:ToolStatusIcon}, Path=ShowErrorIcon}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Path.Style>
        </Path>

    </Grid>

</UserControl>
