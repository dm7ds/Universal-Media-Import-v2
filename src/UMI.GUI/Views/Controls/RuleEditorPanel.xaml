<UserControl
    x:Class="UMI.GUI.Views.Controls.RuleEditorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels">

    <UserControl.Resources>

        <Style x:Key="BurstNumericTextBoxConditional" TargetType="TextBox"
               BasedOn="{StaticResource BurstNumericTextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Background"       Value="{StaticResource BrushBgSurface}" />
                    <Setter Property="BorderBrush"      Value="{StaticResource BrushBorderSubtle}" />
                    <Setter Property="BorderThickness"  Value="1" />
                    <Setter Property="Padding"          Value="6,4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RuleRowTemplate" DataType="{x:Type vm:MatchConditionRowViewModel}">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="72" />

                    <ColumnDefinition Width="80" />

                    <ColumnDefinition Width="28" />

                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    MinWidth="0"
                    Width="68"
                    Margin="0,0,6,0"
                    ItemsSource="{x:Static vm:MatchConditionRowViewModel.LogicOperators}"
                    SelectedItem="{Binding LogicOp, Mode=TwoWay}"
                    IsEnabled="{Binding IsEditing}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource BurstComboBoxStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFirstRow}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <ComboBox
                    Grid.Column="1"
                    Style="{StaticResource BurstComboBoxStyle}"
                    IsEditable="True"
                    IsTextSearchEnabled="False"
                    Margin="0,0,6,0"
                    ItemsSource="{Binding AvailableFields}"
                    Text="{Binding Field, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding IsEditing}"
                    ToolTip="{helpers:Localize RuleEditor_ExifFieldTooltip}" />

                <ComboBox
                    Grid.Column="2"
                    Style="{StaticResource BurstComboBoxStyle}"
                    MinWidth="0"
                    Width="68"
                    Margin="0,0,6,0"
                    ItemsSource="{x:Static vm:MatchConditionRowViewModel.AvailableOperators}"
                    SelectedItem="{Binding Operator, Mode=TwoWay}"
                    IsEnabled="{Binding IsEditing}" />

                <TextBox
                    Grid.Column="3"
                    Width="Auto"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BurstNumericTextBoxConditional}"
                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat='G'}"
                    IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBool}}"
                    ToolTip="{helpers:Localize RuleEditor_NumericThresholdTooltip}" />

                <Button
                    Grid.Column="4"
                    Width="24"
                    Height="24"
                    Cursor="Hand"
                    Command="{Binding RemoveCommand}"
                    ToolTip="{helpers:Localize RuleEditor_RemoveRuleTooltip}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Bd"
                                            Width="24"
                                            Height="24"
                                            CornerRadius="4"
                                            Background="Transparent">
                                            <Path
                                                x:Name="XIcon"
                                                Data="{StaticResource GeoXMark}"
                                                Stroke="{StaticResource BrushTextMuted}"
                                                StrokeThickness="1.5"
                                                Width="10"
                                                Height="10"
                                                Stretch="Uniform"
                                                Fill="Transparent" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushErrorBg}" />
                                                <Setter TargetName="XIcon" Property="Stroke" Value="{StaticResource BrushErrorText}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <StackPanel>

        <TextBlock Text="{helpers:Localize RuleEditor_RuleBuilder}" Style="{StaticResource BurstSectionLabel}" />

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="{helpers:Localize RuleEditor_Logic}"
                FontSize="{StaticResource FontSizeSmall}"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushTextMuted}" />
            <TextBlock
                Grid.Column="1"
                Text="{helpers:Localize RuleEditor_ExifField}"
                FontSize="{StaticResource FontSizeSmall}"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushTextMuted}"
                Margin="0,0,6,0" />
            <TextBlock
                Grid.Column="2"
                Text="{helpers:Localize RuleEditor_Op}"
                FontSize="{StaticResource FontSizeSmall}"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushTextMuted}" />
            <TextBlock
                Grid.Column="3"
                Text="{helpers:Localize RuleEditor_Value}"
                FontSize="{StaticResource FontSizeSmall}"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushTextMuted}"
                Margin="0,0,6,0" />
        </Grid>

        <ItemsControl
            ItemsSource="{Binding Rules}"
            ItemTemplate="{StaticResource RuleRowTemplate}" />

        <TextBlock
            Text="{helpers:Localize RuleEditor_NoRules}"
            FontSize="{StaticResource FontSizeSmall}"
            FontStyle="Italic"
            Foreground="{StaticResource BrushNoFeatures}"
            Margin="0,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Button
            Style="{StaticResource BurstOutlineButton}"
            Padding="10,6"
            HorizontalAlignment="Left"
            Margin="0,8,0,0"
            Command="{Binding AddRuleCommand}"
            ToolTip="{helpers:Localize RuleEditor_AddRuleTooltip}"
            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Path
                    Data="M12,4 V20 M4,12 H20"
                    Stroke="{StaticResource BrushBadgeBurst}"
                    StrokeThickness="1.8"
                    Width="9"
                    Height="9"
                    Stretch="Uniform"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0" />
                <TextBlock
                    Text="{helpers:Localize RuleEditor_AddRule}"
                    FontSize="{StaticResource FontSizeSmall}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrushBadgeBurst}" />
            </StackPanel>
        </Button>

        <Border Style="{StaticResource CardDivider}" Margin="0,14,0,10" />

        <TextBlock Text="{helpers:Localize RuleEditor_Grouping}" Style="{StaticResource BurstSectionLabel}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />

                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="{helpers:Localize RuleEditor_MaxGap}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                ToolTip="{helpers:Localize RuleEditor_MaxGapTooltip}" />
            <TextBox
                Grid.Column="1"
                Style="{StaticResource BurstNumericTextBoxConditional}"
                Text="{Binding Grouping.MaxGapSeconds, UpdateSourceTrigger=PropertyChanged, StringFormat='G'}"
                VerticalAlignment="Center"
                IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBool}}" />

            <TextBlock
                Grid.Column="3"
                Text="{helpers:Localize RuleEditor_MinCount}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                ToolTip="{helpers:Localize RuleEditor_MinCountTooltip}" />
            <TextBox
                Grid.Column="4"
                Style="{StaticResource BurstNumericTextBoxConditional}"
                Text="{Binding Grouping.MinCount, UpdateSourceTrigger=PropertyChanged}"
                VerticalAlignment="Center"
                IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBool}}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox
                IsChecked="{Binding Grouping.AdaptiveThreshold, Mode=TwoWay}"
                IsEnabled="{Binding IsEditing}"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                ToolTip="{helpers:Localize RuleEditor_AdaptiveThresholdTooltip}" />
            <TextBlock
                Text="{helpers:Localize RuleEditor_AdaptiveThreshold}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextSecondary}"
                VerticalAlignment="Center"
                Margin="0,0,20,0" />

            <TextBlock
                Text="{helpers:Localize RuleEditor_Multiplier}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                IsEnabled="{Binding Grouping.AdaptiveThreshold}"
                ToolTip="{helpers:Localize RuleEditor_MultiplierTooltip}" />
            <TextBox
                Style="{StaticResource BurstNumericTextBoxConditional}"
                Text="{Binding Grouping.AdaptiveMultiplier, UpdateSourceTrigger=PropertyChanged, StringFormat='G'}"
                IsEnabled="{Binding Grouping.AdaptiveThreshold}"
                IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBool}}"
                VerticalAlignment="Center" />
        </StackPanel>

        <Border Style="{StaticResource CardDivider}" Margin="0,14,0,10" />
        <TextBlock Text="{helpers:Localize RuleEditor_StableFields}" Style="{StaticResource BurstSectionLabel}" />
        <TextBlock
            Text="{helpers:Localize RuleEditor_StableFieldsDesc}"
            FontSize="{StaticResource FontSizeSmall}"
            Foreground="{StaticResource BrushTextMuted}"
            TextWrapping="Wrap"
            Margin="0,0,0,6" />

        <ItemsControl ItemsSource="{Binding Grouping.StableFields}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Background="{StaticResource BrushBgSurface}"
                        BorderBrush="{StaticResource BrushBadgeBurst}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,3"
                        Margin="0,0,6,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Text="{Binding}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource BrushBadgeBurst}"
                                VerticalAlignment="Center" />

                            <Button
                                Width="14" Height="14"
                                Margin="6,0,0,0"
                                Cursor="Hand"
                                Command="{Binding DataContext.RemoveStableFieldCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Path
                                            Data="{StaticResource GeoXMark}"
                                            Stroke="{StaticResource BrushTextMuted}"
                                            StrokeThickness="1.2"
                                            Width="8" Height="8"
                                            Stretch="Uniform" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel
            Orientation="Horizontal"
            Margin="0,4,0,0"
            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
            <ComboBox
                x:Name="StableFieldCombo"
                Style="{StaticResource BurstComboBoxStyle}"
                IsEditable="True"
                MinWidth="140"
                Margin="0,0,6,0"
                ItemsSource="{Binding AvailableExifFields}"
                ToolTip="{helpers:Localize RuleEditor_StableFieldTooltip}" />
            <Button
                Style="{StaticResource BurstOutlineButton}"
                Padding="8,4"
                Command="{Binding AddStableFieldCommand}"
                CommandParameter="{Binding Text, ElementName=StableFieldCombo}">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Data="M12,4 V20 M4,12 H20"
                        Stroke="{StaticResource BrushBadgeBurst}"
                        StrokeThickness="1.8"
                        Width="8" Height="8"
                        Stretch="Uniform"
                        Margin="0,0,4,0" />
                    <TextBlock
                        Text="{helpers:Localize RuleEditor_Add}"
                        FontSize="{StaticResource FontSizeSmall}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushBadgeBurst}" />
                </StackPanel>
            </Button>
        </StackPanel>

    </StackPanel>

</UserControl>
