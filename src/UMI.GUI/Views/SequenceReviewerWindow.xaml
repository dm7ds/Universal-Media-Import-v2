<Window
    x:Class="UMI.GUI.Views.SequenceReviewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels"
    xmlns:conv="clr-namespace:UMI.GUI.Converters"
    xmlns:controls="clr-namespace:UMI.GUI.Views.Controls"
    Title="{helpers:Localize SequenceReviewer_Title}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResizeWithGrip"
    WindowState="Maximized"
    StateChanged="Window_StateChanged">

    <Window.Resources>
        <ResourceDictionary>
            <!-- ── Reviewer-specific color resources (NML) ── -->
            <!-- Solid near-black used as image area background -->
            <SolidColorBrush x:Key="ReviewerBackgroundBrush" Color="#0a0a0f" />
            <!-- #60000000 — semi-transparent black for nav arrow buttons -->
            <SolidColorBrush x:Key="ReviewerNavOverlayBrush">
                <SolidColorBrush.Color>
                    <Color A="96" R="0" G="0" B="0" />
                </SolidColorBrush.Color>
            </SolidColorBrush>
            <!-- #CC0a0a0f — deep dark overlay with alpha for full-window loading screen -->
            <SolidColorBrush x:Key="ReviewerLoadingOverlayBrush">
                <SolidColorBrush.Color>
                    <Color A="204" R="10" G="10" B="15" />
                </SolidColorBrush.Color>
            </SolidColorBrush>
            <!-- #80000000 — semi-transparent black overlay on main image (e.g. while loading) -->
            <SolidColorBrush x:Key="ReviewerImageOverlayBrush" Color="#80000000" />
            <!-- #CC1a3d1a — dark green badge background for Favorite status -->
            <SolidColorBrush x:Key="ReviewerFavoriteBadgeBrush" Color="#CC1a3d1a" />
            <!-- #CC3d1a1a — dark red badge background for Trash status -->
            <SolidColorBrush x:Key="ReviewerTrashBadgeBrush" Color="#CC3d1a1a" />
            <!-- #88000000 — semi-transparent black dimming overlay for trashed filmstrip items -->
            <SolidColorBrush x:Key="ReviewerTrashDimmingBrush" Color="#88000000" />

            <!-- Star path geometry (filled) -->
            <PathGeometry x:Key="GeoStarFilled">
                <PathFigure StartPoint="12,2" IsClosed="True">
                    <PolyLineSegment Points="15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26 12,2" />
                </PathFigure>
            </PathGeometry>
            <!-- Star path geometry (outline) -->
            <PathGeometry x:Key="GeoStarOutline">
                <PathFigure StartPoint="12,2" IsClosed="True">
                    <PolyLineSegment Points="15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26 12,2" />
                </PathFigure>
            </PathGeometry>

            <!-- Filmstrip thumbnail item style -->
            <Style x:Key="FilmThumbButton" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Background="{TemplateBinding Background}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{StaticResource ColorTextSecondary}" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Action button style: pill shape, semi-transparent -->
            <Style x:Key="ReviewActionButton" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource ColorBgCard}" Opacity="0.85" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusButton}"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{StaticResource ColorBgCardHover}" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="{StaticResource OpacityMuted}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Delete button: red tint when enabled -->
            <Style x:Key="ReviewDeleteButton" TargetType="Button" BasedOn="{StaticResource ReviewActionButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDeleteEnabled}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushErrorBorder}" />
                        <Setter Property="Foreground" Value="{StaticResource BrushErrorText}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Window control button -->
            <Style x:Key="ReviewWinCtrl" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Width="30" Height="30"
                                CornerRadius="15"
                                Background="Transparent">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{StaticResource ColorBgCard}" Opacity="0.9" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Window control icon geometries (NML — defined once here) ── -->
            <!-- Minimize: horizontal line -->
            <Geometry x:Key="GeoMinimize">M4,12 L20,12</Geometry>
            <!-- Maximize: rectangle outline -->
            <Geometry x:Key="GeoMaximize">M4,4 L20,4 L20,20 L4,20 Z</Geometry>
            <!-- Restore: two overlapping rectangles -->
            <Geometry x:Key="GeoRestore">M7,4 L18,4 L18,15 M4,7 L15,7 L15,20 L4,20 Z</Geometry>
            <!-- Help: question mark circle outline -->
            <Geometry x:Key="GeoHelp">M11,18 L13,18 L13,16 L11,16 Z M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M12,20 C7.59,20 4,16.41 4,12 C4,7.59 7.59,4 12,4 C16.41,4 20,7.59 20,12 C20,16.41 16.41,20 12,20 Z M12,6 C9.79,6 8,7.79 8,10 L10,10 C10,8.9 10.9,8 12,8 C13.1,8 14,8.9 14,10 C14,12 11,11.75 11,15 L13,15 C13,12.75 16,12.5 16,10 C16,7.79 14.21,6 12,6 Z</Geometry>

            <!-- ── Custom thin scrollbar style for Filmstrip (dark theme) ── -->
            <Style x:Key="FilmstripScrollBarThumb" TargetType="Thumb">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border
                                CornerRadius="3"
                                Opacity="0.4">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource ColorTextMuted}" />
                                </Border.Background>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FilmstripScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Height" Value="6" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Height="6">
                                <Border
                                    Background="Transparent"
                                    CornerRadius="3" />
                                <Track
                                    x:Name="PART_Track"
                                    IsDirectionReversed="False">
                                    <!-- Left RepeatButton: hidden -->
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
                                            Command="ScrollBar.PageLeftCommand"
                                            Opacity="0"
                                            Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <!-- Thumb -->
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource FilmstripScrollBarThumb}" />
                                    </Track.Thumb>
                                    <!-- Right RepeatButton: hidden -->
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton
                                            Command="ScrollBar.PageRightCommand"
                                            Opacity="0"
                                            Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ScrollViewer style that wires up the custom horizontal scrollbar -->
            <Style x:Key="FilmstripScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollContentPresenter Grid.Row="0" />
                                <ScrollBar
                                    Grid.Row="1"
                                    x:Name="PART_HorizontalScrollBar"
                                    Orientation="Horizontal"
                                    Style="{StaticResource FilmstripScrollBarStyle}"
                                    Value="{TemplateBinding HorizontalOffset}"
                                    Maximum="{TemplateBinding ScrollableWidth}"
                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- Keyboard bindings -->
    <Window.InputBindings>
        <KeyBinding Key="Left"   Command="{Binding NavigateLeftCommand}" />
        <KeyBinding Key="Right"  Command="{Binding NavigateRightCommand}" />
        <KeyBinding Key="Up"     Command="{Binding NavigateUpCommand}" />
        <KeyBinding Key="Down"   Command="{Binding NavigateDownCommand}" />
        <KeyBinding Key="Space"  Command="{Binding ToggleFavoriteCommand}" />
        <KeyBinding Key="X"      Command="{Binding ToggleTrashCommand}" />
        <KeyBinding Key="D1"     Command="{Binding SetRatingCommand}" CommandParameter="1" />
        <KeyBinding Key="D2"     Command="{Binding SetRatingCommand}" CommandParameter="2" />
        <KeyBinding Key="D3"     Command="{Binding SetRatingCommand}" CommandParameter="3" />
        <KeyBinding Key="D4"     Command="{Binding SetRatingCommand}" CommandParameter="4" />
        <KeyBinding Key="D5"     Command="{Binding SetRatingCommand}" CommandParameter="5" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Key="G"      Command="{Binding ToggleOverviewCommand}" />
    </Window.InputBindings>

    <!-- Root: full-screen dark bg -->
    <Border Background="{StaticResource BrushBg}">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Header bar -->
                <RowDefinition Height="48" />
                <!-- Main image -->
                <RowDefinition Height="*" />
                <!-- Filmstrip -->
                <RowDefinition Height="110" />
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- Row 0: Header bar                                         -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border
                Grid.Row="0"
                Background="{StaticResource BrushBgSurface}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Overview toggle + Counters + folder info -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        >

                        <!-- Overview toggle button (G key shortcut) -->
                        <Button
                            Style="{StaticResource ReviewActionButton}"
                            Command="{Binding ToggleOverviewCommand}"
                            Margin="0,0,10,0"
                            ToolTip="{helpers:Localize SequenceReviewer_Overview}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Grid icon when in single-image mode -->
                                <Path
                                    Width="12" Height="12"
                                    Stretch="Uniform"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <!-- Grid (4 squares) — default -->
                                            <Setter Property="Data" Value="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z" />
                                            <Setter Property="Fill" Value="{StaticResource BrushTextSecondary}" />
                                            <Style.Triggers>
                                                <!-- Single-image icon when overview is active -->
                                                <DataTrigger Binding="{Binding IsOverviewMode}" Value="True">
                                                    <Setter Property="Data" Value="M21,3 H3 C1.9,3 1,3.9 1,5 V19 C1,20.1 1.9,21 3,21 H21 C22.1,21 23,20.1 23,19 V5 C23,3.9 22.1,3 21,3 Z M21,19 H3 V5 H21 V19 Z M7,12 H17 V14 H7 Z M7,8 H17 V10 H7 Z" />
                                                    <Setter Property="Fill" Value="{StaticResource BrushDrone}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{helpers:Localize SequenceReviewer_Overview}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverviewMode}" Value="True">
                                                    <Setter Property="Text" Value="{helpers:Localize SequenceReviewer_BackToPhoto}" />
                                                    <Setter Property="Foreground" Value="{StaticResource BrushDrone}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Sequence counter -->
                        <TextBlock
                            Text="{Binding SequenceCounterText}"
                            FontSize="{StaticResource FontSizeSmall}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}"
                            VerticalAlignment="Center" />

                        <!-- Separator -->
                        <TextBlock
                            Text="·"
                            Foreground="{StaticResource BrushTextMuted}"
                            VerticalAlignment="Center"
                            Visibility="{Binding SequenceCounterText, Converter={StaticResource StringToVisibility}}" />

                        <!-- Sequence name -->
                        <TextBlock
                            Text="{Binding CurrentSequence.SequenceName}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource BrushTextSecondary}"
                            VerticalAlignment="Center"
                            MaxWidth="280"
                            TextTrimming="CharacterEllipsis" />

                        <!-- Profile name separator -->
                        <TextBlock
                            Text="·"
                            Foreground="{StaticResource BrushTextMuted}"
                            VerticalAlignment="Center"
                            Visibility="{Binding SelectedProfile.Name, Converter={StaticResource StringToVisibility}}" />

                        <!-- Profile name (colored) -->
                        <TextBlock
                            Text="{Binding SelectedProfile.Name}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{Binding SelectedProfileColorIndex, Converter={StaticResource ProfileColorToBrush}, FallbackValue={StaticResource BrushTextMuted}}"
                            VerticalAlignment="Center"
                            MaxWidth="200"
                            TextTrimming="CharacterEllipsis" />

                        <!-- Separator -->
                        <TextBlock
                            Text="·"
                            Foreground="{StaticResource BrushTextMuted}"
                            VerticalAlignment="Center"
                            Visibility="{Binding PhotoCounterText, Converter={StaticResource StringToVisibility}}" />

                        <!-- Photo counter -->
                        <TextBlock
                            Text="{Binding PhotoCounterText}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource BrushTextMuted}"
                            VerticalAlignment="Center" />

                    </StackPanel>

                    <!-- Centre: Action buttons -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        
                        Margin="0,0,12,0">

                        <!-- Filter: All -->
                        <Button
                            Content="{helpers:Localize SequenceReviewer_FilterAll}"
                            Style="{StaticResource ReviewActionButton}"
                            Margin="0,0,6,0"
                            Command="{Binding ClearFilterCommand}" />

                        <!-- Filter: Favorites -->
                        <Button
                            Style="{StaticResource ReviewActionButton}"
                            Margin="0,0,6,0"
                            Command="{Binding ApplyFilterCommand}"
                            Click="FilterFavorites_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.27 2,8.5 C2,5.41 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.08 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.41 22,8.5 C22,12.27 18.6,15.36 13.45,20.03 L12,21.35 Z"
                                    Fill="{StaticResource BrushBadgeGps}"
                                    Width="12" Height="12"
                                    Stretch="Uniform"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{helpers:Localize SequenceReviewer_FilterFavorites}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Filter: Trash -->
                        <Button
                            Style="{StaticResource ReviewActionButton}"
                            Margin="0,0,6,0"
                            Click="FilterTrash_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Data="M3,6 H5 H21 M8,6 V4 A1,1 0 0,1 9,3 H15 A1,1 0 0,1 16,4 V6 M19,6 V20 A2,2 0 0,1 17,22 H7 A2,2 0 0,1 5,20 V6 H19 Z"
                                    Stroke="{StaticResource BrushErrorText}"
                                    StrokeThickness="1.5"
                                    Width="11" Height="12"
                                    Stretch="Uniform"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{helpers:Localize SequenceReviewer_FilterTrash}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Border
                            Width="1"
                            Margin="8,4"
                            Background="{StaticResource BrushBorderSubtle}" />

                        <!-- Export (primary export action with dialog) -->
                        <Button
                            Content="{helpers:Localize SequenceReviewer_Export}"
                            Style="{StaticResource ReviewActionButton}"
                            Margin="0,0,6,0"
                            Command="{Binding ExportCommand}" />

                        <!-- Enable Delete toggle -->
                        <ToggleButton
                            x:Name="EnableDeleteToggle"
                            IsChecked="{Binding IsDeleteEnabled, Mode=TwoWay}"
                            Content="{helpers:Localize SequenceReviewer_EnableDelete}"
                            Focusable="False"
                            Height="30"
                            Padding="10,5"
                            Margin="0,0,6,0"
                            FontSize="{StaticResource FontSizeSmall}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Foreground="{StaticResource BrushTextMuted}" />

                        <!-- Delete -->
                        <Button
                            Content="{helpers:Localize SequenceReviewer_Delete}"
                            Style="{StaticResource ReviewDeleteButton}"
                            Command="{Binding DeleteCommand}" />

                        <!-- Separator -->
                        <Border
                            Width="1"
                            Margin="8,4"
                            Background="{StaticResource BrushBorderSubtle}" />

                        <!-- DateFilter -->
                        <StackPanel
                            Orientation="Horizontal"
                            DataContext="{Binding DateFilter}">

                            <ToggleButton
                                x:Name="ReviewDateFilterToggle"
                                IsChecked="{Binding IsPopupOpen, Mode=TwoWay}"
                                ToolTip="{helpers:Localize SequenceReviewer_DateFilter}"
                                Style="{StaticResource IconToggleButton}"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Data="M19,3H18V1H16V3H8V1H6V3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V9H19V19M19,7H5V5H19V7Z"
                                        Fill="{StaticResource BrushDrone}"
                                        Width="14" Height="14"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        Margin="0,0,7,0" />
                                    <TextBlock
                                        Text="{helpers:Localize SequenceReviewer_DateRange}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Foreground="{StaticResource BrushDrone}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <Border
                                Visibility="{Binding HasDateFilter, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource WorkbenchPathPill}"
                                Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Text="{Binding DateFilterText}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Foreground="{StaticResource BrushDrone}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Command="{Binding ClearDateFilterCommand}"
                                        ToolTip="{helpers:Localize ProcessTab_ClearDateFilter}"
                                        Cursor="Hand" Margin="6,0,0,0"
                                        Style="{StaticResource CardDeleteButton}"
                                        Width="14" Height="14">
                                        <Path
                                            Data="{StaticResource GeoClose}"
                                            Fill="{StaticResource BrushTextMuted}"
                                            Width="8" Height="8" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <controls:DateFilterPopup
                                HeaderText="{helpers:Localize SequenceReviewer_DateRange}"
                                IsPopupOpen="{Binding IsPopupOpen, Mode=TwoWay}"
                                PlacementTargetRef="{Binding ElementName=ReviewDateFilterToggle}" />

                        </StackPanel>

                        <!-- Camera filter: only shown when > 1 camera found -->
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Visibility="{Binding HasMultipleCameras, Converter={StaticResource BoolToVisibility}}">

                            <!-- Separator -->
                            <Border
                                Width="1"
                                Margin="0,4,8,4"
                                Background="{StaticResource BrushBorderSubtle}" />

                            <!-- Camera icon -->
                            <Path
                                Data="M12,20H4A2,2 0 0,1 2,18V8A2,2 0 0,1 4,6H6L8,4H14L16,6H20A2,2 0 0,1 22,8V10.5C21.37,10.18 20.7,10 20,10C17.24,10 15,12.24 15,15H8A4,4 0 0,0 12,19C12.35,19 12.69,18.96 13.02,18.88C12.67,19.23 12.35,19.6 12.07,20H12M17,12V15H14V17H17V20H19V17H22V15H19V12H17Z"
                                Fill="{StaticResource BrushTextSecondary}"
                                Width="13" Height="13"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Margin="0,0,5,0" />

                            <ComboBox
                                ItemsSource="{Binding AvailableCameras}"
                                SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                                Style="{StaticResource DarkComboBoxStyle}"
                                MinWidth="130"
                                Height="30"
                                VerticalAlignment="Center"
                                ToolTip="{helpers:Localize SequenceReviewer_Camera}"
                                DropDownClosed="ComboBox_DropDownClosed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="">
                                                            <Setter Property="Text" Value="{helpers:Localize SequenceReviewer_AllCameras}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                        </StackPanel>

                        <!-- Separator -->
                        <Border
                            Width="1"
                            Margin="8,4"
                            Background="{StaticResource BrushBorderSubtle}" />

                        <!-- Profile icon -->
                        <Path
                            Data="M4,6H2V20A2,2 0 0,0 4,22H18V20H4V6M20,2H8A2,2 0 0,0 6,4V16A2,2 0 0,0 8,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M20,16H8V4H20V16M10,9H18V11H10V9M10,12H14V14H10V12M10,6H18V8H10V6Z"
                            Fill="{StaticResource BrushTextSecondary}"
                            Width="13" Height="13"
                            Stretch="Uniform"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0" />

                        <!-- Profile dropdown -->
                        <ComboBox
                            ItemsSource="{Binding AvailableProfiles}"
                            SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                            DisplayMemberPath="Name"
                            Style="{StaticResource DarkComboBoxStyle}"
                            MinWidth="130"
                            Height="30"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            ToolTip="{helpers:Localize SequenceReviewer_Profile}"
                            DropDownClosed="ComboBox_DropDownClosed" />

                        <!-- Toggle removed — "Nicht zugeordnet" pseudo-profile replaces it -->

                    </StackPanel>

                    <!-- Right: Help + Minimize + Maximize/Restore + Close -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <!-- Help -->
                        <Button
                            x:Name="HelpButton"
                            Click="HelpButton_Click"
                            Focusable="False"
                            Style="{StaticResource ReviewWinCtrl}"
                            ToolTip="{helpers:Localize Help_TooltipButton}"
                            Margin="0,0,4,0">
                            <Path
                                Data="{StaticResource GeoHelp}"
                                Fill="{StaticResource BrushTextSecondary}"
                                Width="14" Height="14"
                                Stretch="Uniform" />
                        </Button>

                        <!-- Minimize -->
                        <Button
                            Style="{StaticResource ReviewWinCtrl}"
                            Click="MinimizeButton_Click"
                            ToolTip="{helpers:Localize Common_Minimize}">
                            <Path
                                Data="{StaticResource GeoMinimize}"
                                Stroke="{StaticResource BrushTextMuted}"
                                StrokeThickness="1.8"
                                Width="12" Height="12"
                                Stretch="Uniform" />
                        </Button>

                        <!-- Maximize / Restore toggle -->
                        <Button
                            Style="{StaticResource ReviewWinCtrl}"
                            Click="MaximizeRestoreButton_Click"
                            ToolTip="{helpers:Localize Common_MaximizeRestore}">
                            <Path
                                x:Name="MaxRestoreIcon"
                                Data="{StaticResource GeoRestore}"
                                Stroke="{StaticResource BrushTextMuted}"
                                StrokeThickness="1.8"
                                Width="12" Height="12"
                                Stretch="Uniform" />
                        </Button>

                        <!-- Close -->
                        <Button
                            Style="{StaticResource ReviewWinCtrl}"
                            Command="{Binding CloseCommand}">
                            <Path
                                Data="M18,6 L6,18 M6,6 L18,18"
                                Stroke="{StaticResource BrushTextMuted}"
                                StrokeThickness="1.8"
                                Width="12" Height="12"
                                Stretch="Uniform" />
                        </Button>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- Row 1: Main image + overlays (hidden in overview mode)    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverviewMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Dark bg behind image -->
                <Border Background="{StaticResource ReviewerBackgroundBrush}" />

                <!-- Loading overlay -->
                <Border
                    Background="{StaticResource ReviewerImageOverlayBrush}"
                    Visibility="{Binding IsLoadingImage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{helpers:Localize SequenceReviewer_Scanning}"
                        FontSize="{StaticResource FontSizeMedium}"
                        Foreground="{StaticResource BrushTextMuted}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <!-- Empty state: no filter results -->
                <TextBlock
                    Text="{helpers:Localize SequenceReviewer_NoFilterResults}"
                    FontSize="{StaticResource FontSizeBase}"
                    Foreground="{StaticResource BrushTextMuted}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CurrentPhoto}" Value="{x:Null}" />
                                        <Condition Binding="{Binding IsFilterActive}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Empty state: no sequences at all -->
                <TextBlock
                    Text="{helpers:Localize SequenceReviewer_NoSequences}"
                    FontSize="{StaticResource FontSizeBase}"
                    Foreground="{StaticResource BrushTextMuted}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="400"
                    TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CurrentPhoto}" Value="{x:Null}" />
                                        <Condition Binding="{Binding IsFilterActive}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Main image -->
                <Image
                    x:Name="MainImageView"
                    Source="{Binding MainImage}"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Overlay: Tag icon (top-right) -->
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,16,0"
                    Orientation="Horizontal"
                    >

                    <!-- Favorite checkmark -->
                    <Border
                        Width="48" Height="48"
                        CornerRadius="24"
                        Background="{StaticResource ReviewerFavoriteBadgeBrush}"
                        Visibility="{Binding CurrentPhoto.IsFavorite, Converter={StaticResource BoolToVisibility}}">
                        <Path
                            Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"
                            Fill="{StaticResource BrushBadgeGps}"
                            Width="24" Height="24"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- Trash icon -->
                    <Border
                        Width="48" Height="48"
                        CornerRadius="24"
                        Background="{StaticResource ReviewerTrashBadgeBrush}"
                        Visibility="{Binding CurrentPhoto.IsTrash, Converter={StaticResource BoolToVisibility}}">
                        <Path
                            Data="M3,6 H5 H21 M8,6 V4 A1,1 0 0,1 9,3 H15 A1,1 0 0,1 16,4 V6 M19,6 V20 A2,2 0 0,1 17,22 H7 A2,2 0 0,1 5,20 V6 H19 Z"
                            Stroke="{StaticResource BrushErrorText}"
                            StrokeThickness="1.8"
                            Width="22" Height="22"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                </StackPanel>

                <!-- Overlay: Star rating (top-left) -->
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="16,16,0,0"
                    Orientation="Horizontal"
                    
                    Visibility="{Binding CurrentPhoto.HasRating, Converter={StaticResource BoolToVisibility}}">

                    <ItemsControl x:Name="MainRatingStars" ItemsSource="{Binding CurrentPhoto.RatingStars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Path
                                    Width="20" Height="20"
                                    Stretch="Uniform"
                                    Margin="2,0"
                                    Data="{StaticResource GeoStarFilled}"
                                    Fill="{StaticResource BrushBadgeBurst}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <!-- Navigation arrows -->
                <Button
                    x:Name="NavLeft"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    Width="40" Height="80"
                    Background="{StaticResource ReviewerNavOverlayBrush}"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding NavigateLeftCommand}"
                    Opacity="{StaticResource OpacityHint}"
                    Focusable="False">
                    <Path
                        Data="M15,18 L9,12 L15,6"
                        Stroke="{StaticResource BrushTextPrimary}"
                        StrokeThickness="2"
                        Width="10" Height="16"
                        Stretch="Uniform" />
                </Button>

                <Button
                    x:Name="NavRight"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Width="40" Height="80"
                    Background="{StaticResource ReviewerNavOverlayBrush}"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding NavigateRightCommand}"
                    Opacity="{StaticResource OpacityHint}"
                    Focusable="False">
                    <Path
                        Data="M9,18 L15,12 L9,6"
                        Stroke="{StaticResource BrushTextPrimary}"
                        StrokeThickness="2"
                        Width="10" Height="16"
                        Stretch="Uniform" />
                </Button>

            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- Row 2: Filmstrip (hidden in overview mode)               -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border
                Grid.Row="2"
                Background="{StaticResource BrushBgSurface}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="0,1,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverviewMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Prev sequence -->
                    <Button
                        Grid.Column="0"
                        Style="{StaticResource ReviewWinCtrl}"
                        Command="{Binding NavigateUpCommand}"
                        Margin="6,0"
                        VerticalAlignment="Center"
                        ToolTip="{helpers:Localize SequenceReviewer_PrevSequence}">
                        <Path
                            Data="M18,15 L12,9 L6,15"
                            Stroke="{StaticResource BrushTextMuted}"
                            StrokeThickness="1.8"
                            Width="12" Height="8"
                            Stretch="Uniform" />
                    </Button>

                    <!-- Filmstrip scroll -->
                    <ScrollViewer
                        Grid.Column="1"
                        x:Name="FilmstripScroll"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Hidden"
                        VerticalAlignment="Center"
                        Style="{StaticResource FilmstripScrollViewerStyle}"
                        PreviewMouseLeftButtonDown="FilmstripScroll_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="FilmstripScroll_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="FilmstripScroll_PreviewMouseLeftButtonUp">
                        <ItemsControl x:Name="FilmstripItems" ItemsSource="{Binding FilmstripPhotos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ReviewPhotoViewModel}">
                                    <Button
                                        Style="{StaticResource FilmThumbButton}"
                                        Tag="{Binding}"
                                        Click="FilmstripThumb_Click">
                                        <Button.BorderBrush>
                                            <SolidColorBrush x:Name="ThumbBorder" Color="Transparent" />
                                        </Button.BorderBrush>
                                        <Grid Width="80" Height="80"
                                              Background="{StaticResource BrushBgCard}">
                                            <!-- Filename fallback when no thumbnail -->
                                            <TextBlock
                                                Text="{Binding FileName}"
                                                Foreground="{StaticResource BrushTextMuted}"
                                                FontSize="{StaticResource FontSizeTiny}"
                                                TextWrapping="Wrap"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Margin="2"
                                                TextTrimming="CharacterEllipsis" />
                                            <!-- Thumbnail image (covers text when available) -->
                                            <Image
                                                Source="{Binding Thumbnail}"
                                                Stretch="UniformToFill"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                RenderOptions.BitmapScalingMode="HighQuality" />

                                            <!-- Trash dimming -->
                                            <Border
                                                Background="{StaticResource ReviewerTrashDimmingBrush}"
                                                Visibility="{Binding IsTrash, Converter={StaticResource BoolToVisibility}}" />

                                            <!-- Current highlight -->
                                            <Border
                                                BorderThickness="3"
                                                CornerRadius="3"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="{StaticResource ColorDrone}" />
                                                </Border.BorderBrush>
                                            </Border>

                                            <!-- Favorite dot -->
                                            <Ellipse
                                                Width="10" Height="10"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,4,4"
                                                Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="{StaticResource ColorBadgeGps}" />
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <!-- Trash X dot -->
                                            <Border
                                                Width="14" Height="14"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,4,4"
                                                CornerRadius="7"
                                                Visibility="{Binding IsTrash, Converter={StaticResource BoolToVisibility}}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{StaticResource ColorBadgePost}" />
                                                </Border.Background>
                                                <Path
                                                    Data="M10,10 L14,14 M14,10 L10,14"
                                                    Stroke="{StaticResource BrushWhite}"
                                                    StrokeThickness="1.5"
                                                    Width="6" Height="6"
                                                    Stretch="Uniform"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Rating pip row -->
                                            <StackPanel
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Margin="3,0,0,3"
                                                Visibility="{Binding HasRating, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl x:Name="ThumbStars" ItemsSource="{Binding RatingStars}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Path
                                                                Width="7" Height="7"
                                                                Margin="1,0"
                                                                Stretch="Uniform"
                                                                Data="{StaticResource GeoStarFilled}">
                                                                <Path.Fill>
                                                                    <SolidColorBrush Color="{StaticResource ColorBadgeBurst}" />
                                                                </Path.Fill>
                                                            </Path>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Next sequence -->
                    <Button
                        Grid.Column="2"
                        Style="{StaticResource ReviewWinCtrl}"
                        Command="{Binding NavigateDownCommand}"
                        Margin="6,0"
                        VerticalAlignment="Center"
                        ToolTip="{helpers:Localize SequenceReviewer_NextSequence}">
                        <Path
                            Data="M6,9 L12,15 L18,9"
                            Stroke="{StaticResource BrushTextMuted}"
                            StrokeThickness="1.8"
                            Width="12" Height="8"
                            Stretch="Uniform" />
                    </Button>

                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- Sequence Overview Grid (Row 1+2, visible when IsOverviewMode) -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border
                Grid.Row="1" Grid.RowSpan="2"
                Background="{StaticResource BrushBg}"
                Visibility="{Binding IsOverviewMode, Converter={StaticResource BoolToVisibility}}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Filter bar -->
                        <RowDefinition Height="*" />    <!-- Cards grid -->
                    </Grid.RowDefinitions>

                    <!-- Filter bar -->
                    <Border
                        Grid.Row="0"
                        Background="{StaticResource BrushBgSurface}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="0,0,0,1"
                        Padding="16,6">
                        <StackPanel Orientation="Horizontal">

                            <!-- All sequences -->
                            <Button
                                Margin="0,0,6,0"
                                Command="{Binding SetSequenceFilterCommand}"
                                CommandParameter="All">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ReviewActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SequenceFilter}" Value="All">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushDrone}" />
                                                <Setter Property="Foreground" Value="{StaticResource BrushDrone}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{helpers:Localize SequenceReviewer_FilterAllSeq}" />
                            </Button>

                            <!-- Rated -->
                            <Button
                                Margin="0,0,6,0"
                                Command="{Binding SetSequenceFilterCommand}"
                                CommandParameter="Rated">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ReviewActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SequenceFilter}" Value="Rated">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushDrone}" />
                                                <Setter Property="Foreground" Value="{StaticResource BrushDrone}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Data="{StaticResource GeoStarFilled}"
                                        Fill="{StaticResource BrushBadgeBurst}"
                                        Width="10" Height="10"
                                        Stretch="Uniform"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{helpers:Localize SequenceReviewer_FilterRated}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Unrated -->
                            <Button
                                Command="{Binding SetSequenceFilterCommand}"
                                CommandParameter="Unrated">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ReviewActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SequenceFilter}" Value="Unrated">
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushDrone}" />
                                                <Setter Property="Foreground" Value="{StaticResource BrushDrone}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{helpers:Localize SequenceReviewer_FilterUnrated}" />
                            </Button>

                        </StackPanel>
                    </Border>

                    <!-- Cards grid / empty state -->
                    <Grid Grid.Row="1">

                        <!-- Empty state when filter yields no sequences -->
                        <TextBlock
                            Text="{helpers:Localize SequenceReviewer_NoFilteredSeq}"
                            FontSize="{StaticResource FontSizeBase}"
                            Foreground="{StaticResource BrushTextMuted}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredSequences.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Sequence cards -->
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="8,8,8,8">
                            <ItemsControl ItemsSource="{Binding FilteredSequences}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ReviewSequenceViewModel}">

                                        <!-- Sequence card button -->
                                        <Button
                                            Focusable="False"
                                            Cursor="Hand"
                                            Margin="8"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.SelectSequenceFromOverviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Button.Template>

                                            <Border
                                                x:Name="CardBorder"
                                                Width="190"
                                                Background="{StaticResource BrushBgCard}"
                                                CornerRadius="{StaticResource RadiusCard}"
                                                ClipToBounds="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <StackPanel>

                                                        <!-- Thumbnail area (160x100) -->
                                                        <Border
                                                            Height="110"
                                                            ClipToBounds="True">
                                                            <Grid Background="{StaticResource BrushBg}">
                                                                <!-- Filename fallback -->
                                                                <TextBlock
                                                                    Text="{Binding CoverPhoto.FileName}"
                                                                    Foreground="{StaticResource BrushTextMuted}"
                                                                    FontSize="{StaticResource FontSizeSmall}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    Margin="8" />
                                                                <!-- Thumbnail image -->
                                                                <Image
                                                                    Source="{Binding CoverPhoto.Thumbnail}"
                                                                    Stretch="UniformToFill"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    RenderOptions.BitmapScalingMode="HighQuality" />
                                                                <!-- Sequence color strip (top edge) — profile color -->
                                                                <Border
                                                                    Height="3"
                                                                    VerticalAlignment="Top"
                                                                    Background="{Binding ProfileColorIndex, Converter={StaticResource ProfileColorToBrush}, FallbackValue={StaticResource BrushBorderSubtle}}" />
                                                            </Grid>
                                                        </Border>

                                                        <!-- Name + photo count -->
                                                        <StackPanel Margin="10,8,10,4">
                                                            <TextBlock
                                                                Text="{Binding SequenceName}"
                                                                FontSize="{StaticResource FontSizeBase}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource BrushTextPrimary}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Text="{Binding PhotoCountText}"
                                                                FontSize="{StaticResource FontSizeSmall}"
                                                                Foreground="{StaticResource BrushTextMuted}"
                                                                Margin="0,2,0,0" />
                                                            <!-- Capture date (from first photo) -->
                                                            <TextBlock
                                                                Text="{Binding CoverCaptureDate}"
                                                                FontSize="{StaticResource FontSizeSmall}"
                                                                Foreground="{StaticResource BrushTextMuted}"
                                                                Margin="0,2,0,0"
                                                                Visibility="{Binding CoverCaptureDate, Converter={StaticResource StringToVisibility}}" />
                                                            <!-- Source profile name (visible in "Alle Sequenzen" mode) -->
                                                            <TextBlock
                                                                Text="{Binding SourceProfileName}"
                                                                FontSize="{StaticResource FontSizeSmall}"
                                                                Foreground="{Binding ProfileColorIndex, Converter={StaticResource ProfileColorToBrush}, FallbackValue={StaticResource BrushAction}}"
                                                                FontStyle="Italic"
                                                                Margin="0,2,0,0"
                                                                Visibility="{Binding SourceProfileName, Converter={StaticResource StringToVisibility}}" />
                                                        </StackPanel>

                                                        <!-- Status badges -->
                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            Margin="10,0,10,10">

                                                            <!-- Starred count (visible when StarredCount > 0) -->
                                                            <StackPanel
                                                                Orientation="Horizontal"
                                                                Margin="0,0,8,0">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding StarredCount}" Value="0">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <Path
                                                                    Data="{StaticResource GeoStarFilled}"
                                                                    Fill="{StaticResource BrushBadgeBurst}"
                                                                    Width="10" Height="10"
                                                                    Stretch="Uniform"
                                                                    Margin="0,0,3,0"
                                                                    VerticalAlignment="Center" />
                                                                <TextBlock
                                                                    Text="{Binding StarredCount}"
                                                                    FontSize="{StaticResource FontSizeSmall}"
                                                                    Foreground="{StaticResource BrushBadgeBurst}"
                                                                    VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <!-- Favorites count (visible when FavoritesCount > 0) -->
                                                            <StackPanel
                                                                Orientation="Horizontal"
                                                                Margin="0,0,8,0">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FavoritesCount}" Value="0">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <Path
                                                                    Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.27 2,8.5 C2,5.41 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.08 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.41 22,8.5 C22,12.27 18.6,15.36 13.45,20.03 L12,21.35 Z"
                                                                    Fill="{StaticResource BrushBadgeGps}"
                                                                    Width="10" Height="10"
                                                                    Stretch="Uniform"
                                                                    Margin="0,0,3,0"
                                                                    VerticalAlignment="Center" />
                                                                <TextBlock
                                                                    Text="{Binding FavoritesCount}"
                                                                    FontSize="{StaticResource FontSizeSmall}"
                                                                    Foreground="{StaticResource BrushBadgeGps}"
                                                                    VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <!-- Trash count (visible when TrashCount > 0) -->
                                                            <StackPanel Orientation="Horizontal">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding TrashCount}" Value="0">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <Path
                                                                    Data="M3,6 H5 H21 M8,6 V4 A1,1 0 0,1 9,3 H15 A1,1 0 0,1 16,4 V6 M19,6 V20 A2,2 0 0,1 17,22 H7 A2,2 0 0,1 5,20 V6 H19 Z"
                                                                    Stroke="{StaticResource BrushErrorText}"
                                                                    StrokeThickness="1.5"
                                                                    Width="10" Height="10"
                                                                    Stretch="Uniform"
                                                                    Margin="0,0,3,0"
                                                                    VerticalAlignment="Center" />
                                                                <TextBlock
                                                                    Text="{Binding TrashCount}"
                                                                    FontSize="{StaticResource FontSizeSmall}"
                                                                    Foreground="{StaticResource BrushErrorText}"
                                                                    VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <!-- Unrated label (all counts are 0) -->
                                                            <TextBlock
                                                                Text="{helpers:Localize SequenceReviewer_FilterUnrated}"
                                                                FontSize="{StaticResource FontSizeSmall}"
                                                                Foreground="{StaticResource BrushTextMuted}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasRatedPhotos}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Current sequence highlight border overlay -->
                                                    <Border
                                                        BorderThickness="2"
                                                        CornerRadius="{StaticResource RadiusCard}"
                                                        IsHitTestVisible="False">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <!-- IsCurrentInOverview pattern: DataTrigger.Value cannot accept a
                                                                         Binding (not a DependencyProperty), so we use a bool VM property -->
                                                                    <DataTrigger Binding="{Binding IsCurrentInOverview}" Value="True">
                                                                        <Setter Property="BorderBrush">
                                                                            <Setter.Value>
                                                                                <SolidColorBrush Color="{StaticResource ColorDrone}" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                </Grid>
                                            </Border>

                                        </Button>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </Grid>

                </Grid>
            </Border>

            <!-- Info banner: no series detected / empty folder fallback
                 Sits in Root-Grid Row 1+2 so it is visible in BOTH image-view AND overview mode.
                 Visibility driven exclusively by HasEmptyHint — independent of IsOverviewMode. -->
            <Border
                Grid.Row="1"
                Grid.RowSpan="2"
                VerticalAlignment="Top"
                Background="{StaticResource BrushInfoBg}"
                BorderBrush="{StaticResource BrushInfoBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                Visibility="{Binding HasEmptyHint, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M13,7H11V9H13V7M13,11H11V17H13V11Z"
                        Fill="{StaticResource BrushInfoText}"
                        Width="16" Height="16"
                        Stretch="Uniform"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />
                    <TextBlock
                        Text="{Binding EmptyHint}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource BrushInfoText}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Loading overlay (full window) -->
            <Grid
                Grid.RowSpan="3"
                Background="{StaticResource ReviewerLoadingOverlayBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    >
                    <TextBlock
                        Text="{helpers:Localize SequenceReviewer_Scanning}"
                        FontSize="{StaticResource FontSizeLarge}"
                        FontWeight="Light"
                        Foreground="{StaticResource BrushTextPrimary}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{Binding LoadingText}"
                        FontSize="{StaticResource FontSizeBase}"
                        Foreground="{StaticResource BrushTextSecondary}"
                        HorizontalAlignment="Center"
                        Visibility="{Binding LoadingText, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
