<Window
    x:Class="UMI.GUI.Views.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="clr-namespace:UMI.GUI.Behaviors"
    Title="{Binding Title, Mode=OneWay}"
    Width="520"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    FocusManager.FocusedElement="{Binding ElementName=SafeButton}">

    <Border CornerRadius="{StaticResource RadiusDialog}" BorderThickness="1" Margin="16">
        <Border.Background>
            <SolidColorBrush Color="{StaticResource ColorBgSurface}" />
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="{StaticResource ColorBorder}" />
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="{StaticResource ShadowDialogBlurRadius}"
                ShadowDepth="{StaticResource ShadowDialogShadowDepth}"
                Direction="{StaticResource ShadowDialogDirection}"
                Color="{StaticResource ColorShadow}"
                Opacity="{StaticResource ShadowDialogOpacity}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <Border
                Grid.Row="0"
                Padding="20,16,20,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                beh:WindowDragBehavior.IsEnabled="True">
                <TextBlock
                    Text="{Binding Title, Mode=OneWay}"
                    FontSize="{StaticResource FontSizeLarge}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrushTextPrimary}" />
            </Border>

            <!-- ── Frage und Folgen ── -->
            <TextBlock
                Grid.Row="1"
                Margin="20,16,20,16"
                Text="{Binding Message, Mode=OneWay}"
                FontSize="{StaticResource FontSizeBody}"
                Foreground="{StaticResource BrushTextPrimary}"
                TextWrapping="Wrap" />

            <!-- ── Aktionen: riskante Antwort links/zurueckhaltend, sichere Antwort rechts/hervorgehoben ── -->
            <Border
                Grid.Row="2"
                Padding="20,12,20,16"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource BrushBorderSubtle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Command="{Binding ConfirmCommand}"
                        Content="{Binding ConfirmText, Mode=OneWay}"
                        Padding="16,7"
                        Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Foreground" Value="{StaticResource BrushErrorText}" />
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        x:Name="SafeButton"
                        Command="{Binding CancelCommand}"
                        Content="{Binding CancelText, Mode=OneWay}"
                        Padding="16,7"
                        IsDefault="True"
                        IsCancel="True"
                        Style="{StaticResource EditCamLinkButton}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
