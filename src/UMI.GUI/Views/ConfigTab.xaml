<UserControl
    x:Class="UMI.GUI.Views.ConfigTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels"
    xmlns:views="clr-namespace:UMI.GUI.Views"
    xmlns:beh="clr-namespace:UMI.GUI.Behaviors"
    DataContext="{Binding ConfigViewModel}">

    <TabControl
        Style="{StaticResource DarkTabControlStyle}"
        SelectedIndex="{Binding SelectedTabIndex}">

        <TabItem Header="{helpers:Localize ConfigTab_Cameras}" Style="{StaticResource DarkTabItemStyle}">
            <ScrollViewer Padding="20,16">
                <StackPanel>

                    <!-- ── App-Einstellungen (gebunden an MainViewModel) ── -->
                    <StackPanel Margin="0,0,0,24"
                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock
                            Text="{helpers:Localize ConfigTab_AppSettings}"
                            FontSize="{StaticResource FontSizeMedium}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock
                            Text="{helpers:Localize ConfigTab_AppSettingsDesc}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource BrushTextMuted}"
                            Margin="0,4,0,12"
                            TextWrapping="Wrap" />

                        <CheckBox
                            IsChecked="{Binding CheckForUpdatesOnStartup}"
                            Foreground="{StaticResource BrushTextPrimary}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Cursor="Hand"
                            Margin="0,0,0,4">
                            <CheckBox.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        Text="{helpers:Localize ConfigTab_CheckForUpdates}"
                                        Foreground="{StaticResource BrushTextPrimary}"
                                        FontSize="{StaticResource FontSizeSmall}" />
                                </StackPanel>
                            </CheckBox.Content>
                        </CheckBox>
                    </StackPanel>

                    <!-- Trennlinie -->
                    <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,0,0,20"
                            Opacity="{StaticResource OpacityMuted}" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                Text="{helpers:Localize ConfigTab_CamerasHeader}"
                                FontSize="{StaticResource FontSizeMedium}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock
                                Text="{helpers:Localize ConfigTab_CamerasDesc}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Margin="0,4,0,0" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Command="{Binding DataContext.ShowSetupWizardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">

                                    <Path
                                        Data="M12,6V9L16,5L12,1V4A8,8 0 0,0 4,12C4,13.57 4.46,15.03 5.24,16.26L6.7,14.8C6.25,13.97 6,13 6,12A6,6 0 0,1 12,6M18.76,7.74L17.3,9.2C17.74,10.04 18,11 18,12A6,6 0 0,1 12,18V15L8,19L12,23V20A8,8 0 0,0 20,12C20,10.43 19.54,8.97 18.76,7.74Z"
                                        Fill="{StaticResource BrushTextSecondary}"
                                        Width="11"
                                        Height="11"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0" />
                                    <TextBlock
                                        Text="{helpers:Localize ConfigTab_RestartWizard}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource BrushTextSecondary}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Command="{Binding DataContext.AddCameraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            VerticalAlignment="Center"
                            Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource EditCamLinkButton}">
                                    <Setter Property="Padding" Value="14,7" />
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Data="M12,4 V20 M4,12 H20"
                                        Stroke="{StaticResource BrushDrone}"
                                        StrokeThickness="2"
                                        Width="12"
                                        Height="12"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Opacity="{StaticResource OpacityHover}" />
                                    <TextBlock
                                        Text="{helpers:Localize ConfigTab_AddCamera}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource BrushDrone}"
                                        Opacity="{StaticResource OpacityHover}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>

                <ItemsControl ItemsSource="{Binding DataContext.CameraGroups, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CameraGroupViewModel}">
                            <StackPanel Margin="0,0,0,24">

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource GroupHeaderText}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource GroupHeaderText}"
                                               Text="{Binding CountText}" />
                                </Grid>

                                <Border
                                    Height="1"
                                    Margin="0,0,0,10"
                                    Opacity="{StaticResource OpacityMuted}"
                                    Background="{Binding GroupColor, Converter={StaticResource HexToBrush}}" />

                                <ItemsControl
                                    ItemsSource="{Binding Cameras}"
                                    beh:CardMode.ShowAdvanced="True"
                                    PreviewKeyDown="CameraCards_PreviewKeyDown" />

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{helpers:Localize ConfigTab_Profiles}" Style="{StaticResource DarkTabItemStyle}"
                 Visibility="{Binding DataContext.IsAdvancedMode,
                     RelativeSource={RelativeSource AncestorType=Window},
                     Converter={StaticResource BoolToVisibility}}">
            <views:ProfilesTab DataContext="{Binding Profiles}" />
        </TabItem>

        <TabItem Header="{helpers:Localize ConfigTab_Devices}" Style="{StaticResource DarkTabItemStyle}">
            <views:DevicesTab DataContext="{Binding Devices}" />
        </TabItem>

        <TabItem Header="{helpers:Localize ConfigTab_Tools}" Style="{StaticResource DarkTabItemStyle}">
            <views:ToolsConfigTab DataContext="{Binding Tools}" />
        </TabItem>

        <TabItem Header="{helpers:Localize ConfigTab_Burst}" Style="{StaticResource DarkTabItemStyle}"
                 Visibility="{Binding DataContext.IsAdvancedMode,
                     RelativeSource={RelativeSource AncestorType=Window},
                     Converter={StaticResource BoolToVisibility}}">
            <views:BurstTab DataContext="{Binding BurstTab}" />
        </TabItem>

    </TabControl>
</UserControl>
