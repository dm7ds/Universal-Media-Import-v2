<Window
    x:Class="UMI.GUI.Views.Wizard.SetupWizardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels.Wizard"
    xmlns:beh="clr-namespace:UMI.GUI.Behaviors"
    Title="Setup Wizard"
    Width="820"
    Height="640"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="True">

    <Window.Resources>
        <ResourceDictionary Source="WizardStepTemplates.xaml" />
    </Window.Resources>

    <Border CornerRadius="{StaticResource RadiusDialog}" BorderThickness="1" Margin="16">
        <Border.Background>
            <SolidColorBrush Color="{StaticResource ColorBgSurface}" />
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="{StaticResource ColorBorder}" />
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="{StaticResource ShadowDialogBlurRadius}"
                ShadowDepth="{StaticResource ShadowDialogShadowDepth}"
                Direction="{StaticResource ShadowDialogDirection}"
                Color="{StaticResource ColorShadow}"
                Opacity="{StaticResource ShadowDialogOpacity}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="24,16,20,14"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                beh:WindowDragBehavior.IsEnabled="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource ColorHeaderGradientStart}" Offset="0" />
                        <GradientStop Color="{StaticResource ColorHeaderGradientEnd}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">

                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Fill="{StaticResource BrushDrone}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Text="{helpers:Localize Wizard_Title}"
                                FontSize="{StaticResource FontSizeLarge}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock
                                Text="{helpers:Localize Wizard_Subtitle}"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource DialogCloseButton}" />
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="24,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource BrushBorderSubtle}">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource ColorBgSurface}" />
                </Border.Background>

                <ItemsControl ItemsSource="{Binding ActiveSteps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">

                                <Ellipse
                                    x:Name="StepDot"
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center"
                                    Margin="0,0,5,0"
                                    Fill="{StaticResource BrushTextMuted}" />

                                <TextBlock
                                    x:Name="StepLabel"
                                    Text="{Binding StepTitle}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Text=" /"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    VerticalAlignment="Center"
                                    Opacity="0.35"
                                    Margin="4,0,0,0" />
                            </StackPanel>
                            <DataTemplate.Triggers>

                                <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                                    <Setter TargetName="StepDot" Property="Width" Value="9" />
                                    <Setter TargetName="StepDot" Property="Height" Value="9" />
                                    <Setter TargetName="StepDot" Property="Fill" Value="{StaticResource BrushDrone}" />
                                    <Setter TargetName="StepLabel" Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                    <Setter TargetName="StepLabel" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter TargetName="StepDot" Property="Fill" Value="{StaticResource BrushTextSecondary}" />
                                    <Setter TargetName="StepLabel" Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <ScrollViewer
                Grid.Row="2"
                VerticalScrollBarVisibility="Auto"
                Padding="0">
                <ContentPresenter
                    Content="{Binding CurrentStep}"
                    Margin="0" />
            </ScrollViewer>

            <Border
                Grid.Row="3"
                Padding="24,14"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource BrushBorderSubtle}">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource ColorBgSurface}" />
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Command="{Binding BackCommand}"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Left"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Data="M15,18 L9,12 L15,6"
                                Stroke="{StaticResource BrushTextSecondary}"
                                StrokeThickness="2"
                                Fill="Transparent"
                                Width="10"
                                Height="10"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0" />
                            <TextBlock
                                Text="{helpers:Localize Wizard_Back}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextSecondary}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,8,0"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="CancelNavBorder"
                                                CornerRadius="{StaticResource RadiusGroup}"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                Height="36"
                                                Padding="18,0"
                                                Background="Transparent">
                                                <TextBlock
                                                    x:Name="CancelNavText"
                                                    Text="{helpers:Localize Wizard_Cancel}"
                                                    FontSize="{StaticResource FontSizeSmall}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource BrushTextSecondary}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CancelNavBorder" Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                                    <Setter TargetName="CancelNavText" Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Command="{Binding NextCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Text="{helpers:Localize Wizard_Next}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushDrone}"
                                VerticalAlignment="Center" />
                            <Path
                                Data="M9,18 L15,12 L9,6"
                                Stroke="{StaticResource BrushDrone}"
                                StrokeThickness="2"
                                Fill="Transparent"
                                Width="10"
                                Height="10"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Command="{Binding FinishCommand}"
                        IsEnabled="{Binding CurrentStep.IsValid}"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource BrushBg}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Data="{StaticResource GeoCheckmarkFilled}"
                                Fill="{StaticResource BrushBg}"
                                Width="13"
                                Height="13"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Margin="0,0,7,0" />
                            <TextBlock
                                Text="{helpers:Localize Wizard_Finish}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushBg}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
