                    <Border Style="{StaticResource CardDivider}" Margin="0,0,0,12" />

                    <TextBlock
                        Text="{helpers:Localize Wizard_SummaryCamerasLabel}"
                        Style="{StaticResource GroupHeaderText}"
                        Margin="0,0,0,8" />

                    <ItemsControl
                        ItemsSource="{Binding Cameras}"
                        Margin="0,0,0,8"
