    <DataTemplate DataType="{x:Type steps:AddCardsStepViewModel}">
        <StackPanel Margin="28,24,28,20">

            <TextBlock
                Text="{Binding StepTitle}"
                FontSize="{StaticResource FontSizeLarge}"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushTextPrimary}" />
            <TextBlock
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                Margin="0,4,0,4"
                TextWrapping="Wrap">
                <Run Text="{helpers:Localize Wizard_RegisterSdCards}" />
                <Run Text="{Binding CameraName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
            </TextBlock>
            <TextBlock
                Text="{Binding StepDescription}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                Margin="0,0,0,20"
                TextWrapping="Wrap" />

            <TextBlock
                Text="{helpers:Localize Wizard_AssignedCards}"
                Style="{StaticResource GroupHeaderText}"
                Margin="0,0,0,8"
                Visibility="{Binding HasAssignedCards, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl
                ItemsSource="{Binding AssignedCards}"
                Margin="0,0,0,16"
                Visibility="{Binding HasAssignedCards, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type steps:CardAssignment}">
                        <Border
                            Margin="0,0,0,6"
                            Padding="12,10"
                            CornerRadius="{StaticResource RadiusGroup}"
                            BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource ColorCardConnected}" Opacity="0.4" />
                            </Border.BorderBrush>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Padding="8,4"
                                    CornerRadius="{StaticResource RadiusBadge}"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource ColorBadgeGpsBg}" />
                                    </Border.Background>
                                    <TextBlock
                                        Text="{Binding DriveLetter}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        FontWeight="SemiBold"
                                        FontFamily="{StaticResource FontMono}"
                                        Foreground="{StaticResource BrushBadgeGps}" />
                                </Border>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding DisplayLabel}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding SizeInfo}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    VerticalAlignment="Center"
                                    Margin="8,0,8,0" />

                                <Button
                                    Grid.Column="3"
                                    Style="{StaticResource SecondaryActionButton}"
                                    Command="{Binding DataContext.RemoveCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="6,4"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                    <Path
                                        Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"
                                        Fill="{StaticResource BrushTextMuted}"
                                        Width="10"
                                        Height="10"
                                        Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Text="{helpers:Localize Wizard_NoCardsYet}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                FontStyle="Italic"
                Margin="0,0,0,16"
                Visibility="{Binding HasAssignedCards, Converter={StaticResource InvertedBoolToVisibility}}" />

            <StackPanel Visibility="{Binding HasAvailableDrives, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    Text="{helpers:Localize Wizard_AvailableDrives}"
                    Style="{StaticResource GroupHeaderText}"
                    Margin="0,0,0,8" />

                <ItemsControl
                    ItemsSource="{Binding AvailableDrives}"
                    Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type steps:SourceItem}">
                            <Border
                                Margin="0,0,0,6"
                                Padding="12,10"
                                CornerRadius="{StaticResource RadiusGroup}"
                                BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{StaticResource ColorBorderSubtle}" />
                                </Border.BorderBrush>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Padding="8,4"
                                        CornerRadius="{StaticResource RadiusBadge}"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{StaticResource ColorDroneMuted}" />
                                        </Border.Background>
                                        <TextBlock
                                            Text="{Binding DriveLetter}"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            FontWeight="SemiBold"
                                            FontFamily="{StaticResource FontMono}"
                                            Foreground="{StaticResource BrushDrone}" />
                                    </Border>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding DisplayName}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Foreground="{StaticResource BrushTextPrimary}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />

                                    <Button
                                        Grid.Column="2"
                                        Style="{StaticResource SecondaryActionButton}"
                                        Command="{Binding DataContext.AddCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="10,4"
                                        Cursor="Hand"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{helpers:Localize Wizard_AddButton}"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrushDrone}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock
                Text="{Binding StatusMessage}"
                FontSize="{StaticResource FontSizeSmall}"
                FontFamily="{StaticResource FontMono}"
                Foreground="{StaticResource BrushTextMuted}"
                TextWrapping="Wrap"
                Margin="0,0,0,8"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Ellipse
                    Width="6"
                    Height="6"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{StaticResource ColorTextMuted}" />
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock
                    Text="{helpers:Localize Wizard_InsertAnotherSd}"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushTextMuted}"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:SummaryStepViewModel}">
        <StackPanel Margin="28,24,28,20">

            <TextBlock
                Text="{Binding StepTitle}"
                FontSize="{StaticResource FontSizeLarge}"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushTextPrimary}" />
            <TextBlock
                Text="{Binding StepDescription}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                Margin="0,4,0,20"
                TextWrapping="Wrap" />

            <Border Style="{StaticResource ToolRowCard}">
                <StackPanel>

                    <TextBlock
                        Text="{helpers:Localize Wizard_SummaryModeLabel}"
                        Style="{StaticResource GroupHeaderText}"
                        Margin="0,0,0,6" />
                    <TextBlock
                        Text="{Binding SelectedModeName}"
                        FontSize="{StaticResource FontSizeBase}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushTextPrimary}"
