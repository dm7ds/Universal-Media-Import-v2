                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Tools.ExifToolIsValid, Converter={StaticResource BoolToVisibility}}">
                            <Path.Fill>
                                <SolidColorBrush Color="{StaticResource ColorBadgeGps}" />
                            </Path.Fill>
                        </Path>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ToolPathDisplay}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tools.ExifToolIsEmpty}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushErrorBorder}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontFamily="{StaticResource FontMono}"
                                FontSize="{StaticResource FontSizeBody}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                        <Setter Property="Text" Value="{Binding Tools.ExifToolPath}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tools.ExifToolIsEmpty}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushErrorText}" />
                                                <Setter Property="Text" Value="{helpers:Localize Wizard_NotConfiguredRequired}" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Button
                            Grid.Column="1"
                            Command="{Binding Tools.BrowseExifToolCommand}"
                            Style="{StaticResource ToolBrowseButton}"
                            Content="{helpers:Localize Wizard_BrowseTool}"
                            Cursor="Hand" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ToolRowCard}" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock
                            Text="{helpers:Localize Wizard_GyroflowName}"
                            FontSize="{StaticResource FontSizeBase}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}" />
                        <Border Style="{StaticResource ToolOptionalBadge}" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OPTIONAL" Style="{StaticResource ToolOptionalBadgeText}" />
                        </Border>
                        <TextBlock
                            Text="{helpers:Localize Wizard_VideoStab}"
                            FontSize="{StaticResource FontSizeCaption}"
                            Foreground="{StaticResource BrushTextMuted}"
                            VerticalAlignment="Center" />
                        <Button
                            Command="{Binding Tools.DownloadGyroflowCommand}"
                            Style="{StaticResource ToolBrowseButton}"
                            Content="{helpers:Localize Wizard_InstallButton}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding Tools.IsDownloading, Converter={StaticResource InverseBool}}"
                            ToolTip="{helpers:Localize Wizard_InstallGyroflowTooltip}" />
                        <Path
                            Data="{StaticResource GeoCheckmarkFilled}"
                            Stretch="Uniform" Width="14" Height="14"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Tools.GyroflowIsValid, Converter={StaticResource BoolToVisibility}}">
                            <Path.Fill>
                                <SolidColorBrush Color="{StaticResource ColorBadgeGps}" />
                            </Path.Fill>
                        </Path>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ToolPathDisplay}" Margin="0,0,8,0">
                            <TextBlock
                                Text="{Binding Tools.GyroflowPath}"
                                FontFamily="{StaticResource FontMono}"
                                FontSize="{StaticResource FontSizeBody}"
                                Foreground="{StaticResource BrushTextPrimary}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Button
                            Grid.Column="1"
                            Command="{Binding Tools.BrowseGyroflowCommand}"
                            Style="{StaticResource ToolBrowseButton}"
                            Content="{helpers:Localize Wizard_BrowseTool}"
                            Cursor="Hand" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ToolRowCard}" Margin="0,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock
                            Text="{helpers:Localize Wizard_FFprobeName}"
                            FontSize="{StaticResource FontSizeBase}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}" />
                        <Border Style="{StaticResource ToolOptionalBadge}" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OPTIONAL" Style="{StaticResource ToolOptionalBadgeText}" />
                        </Border>
                        <TextBlock
                            Text="{helpers:Localize Wizard_MediaAnalysis}"
                            FontSize="{StaticResource FontSizeCaption}"
                            Foreground="{StaticResource BrushTextMuted}"
                            VerticalAlignment="Center" />
                        <Button
                            Command="{Binding Tools.DownloadFFprobeCommand}"
                            Style="{StaticResource ToolBrowseButton}"
                            Content="{helpers:Localize Wizard_InstallButton}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding Tools.IsDownloading, Converter={StaticResource InverseBool}}"
                            ToolTip="{helpers:Localize Wizard_InstallFFprobeTooltip}" />
                        <Path
                            Data="{StaticResource GeoCheckmarkFilled}"
                            Stretch="Uniform" Width="14" Height="14"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Tools.FFprobeIsValid, Converter={StaticResource BoolToVisibility}}">
                            <Path.Fill>
                                <SolidColorBrush Color="{StaticResource ColorBadgeGps}" />
                            </Path.Fill>
                        </Path>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ToolPathDisplay}" Margin="0,0,8,0">
                            <TextBlock
                                Text="{Binding Tools.FFprobePath}"
                                FontFamily="{StaticResource FontMono}"
                                FontSize="{StaticResource FontSizeBody}"
                                Foreground="{StaticResource BrushTextPrimary}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Button
                            Grid.Column="1"
                            Command="{Binding Tools.BrowseFFprobeCommand}"
                            Style="{StaticResource ToolBrowseButton}"
                            Content="{helpers:Localize Wizard_BrowseTool}"
                            Cursor="Hand" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding Tools.IsDownloading, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                <TextBlock
                    Text="{Binding Tools.DownloadStatusMessage}"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushTextSecondary}"
                    Margin="0,0,0,4" />
                <ProgressBar
                    Value="{Binding Tools.DownloadProgress, Mode=OneWay}"
                    Maximum="100"
                    Height="4"
                    Foreground="{StaticResource BrushAction}"
                    Background="{StaticResource BrushBorderSubtle}" />
            </StackPanel>

        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:GpsStepViewModel}">
        <StackPanel Margin="28,24,28,20">

            <TextBlock
                Text="{Binding StepTitle}"
                FontSize="{StaticResource FontSizeLarge}"
                FontWeight="SemiBold"
