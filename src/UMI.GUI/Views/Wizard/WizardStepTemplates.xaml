                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type wizard:WizardCameraEntry}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding CameraId}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        FontFamily="{StaticResource FontMono}"
                                        Foreground="{StaticResource BrushTextMuted}"
                                        VerticalAlignment="Top"
                                        Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrushTextPrimary}" />
                                        <TextBlock
                                            Text="{Binding CameraType}"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{StaticResource BrushDrone}"
                                            Margin="0,2,0,0" />
                                        <TextBlock
                                            Text="{Binding SourcesSummary}"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            FontFamily="{StaticResource FontMono}"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Margin="0,2,0,0"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Text="{helpers:Localize Wizard_SummaryNoCameras}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource BrushTextMuted}"
                        FontStyle="Italic"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasCameras, Converter={StaticResource InvertedBoolToVisibility}}" />

                    <StackPanel Visibility="{Binding HasGpsFolder, Converter={StaticResource BoolToVisibility}}">

                        <Border Style="{StaticResource CardDivider}" Margin="0,0,0,12" />

                        <TextBlock
                            Text="{helpers:Localize Wizard_SummaryGpsLabel}"
                            Style="{StaticResource GroupHeaderText}"
                            Margin="0,0,0,6" />
                        <TextBlock
                            Text="{Binding GpsFolder}"
                            FontSize="{StaticResource FontSizeSmall}"
                            FontFamily="{StaticResource FontMono}"
                            Foreground="{StaticResource BrushTextPrimary}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Path
                    Data="{StaticResource GeoCheckmarkFilled}"
                    Fill="{StaticResource BrushBadgeGps}"
                    Width="14"
                    Height="14"
                    Stretch="Uniform"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0" />
                <TextBlock
                    Text="{helpers:Localize Wizard_SummaryReady}"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushBadgeGps}"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
