                            <TextBlock Text="REQUIRED" Style="{StaticResource ToolRequiredBadgeText}" />
                        </Border>
                        <TextBlock
                            Text="{helpers:Localize Wizard_ExifReadWrite}"
                            FontSize="{StaticResource FontSizeCaption}"
