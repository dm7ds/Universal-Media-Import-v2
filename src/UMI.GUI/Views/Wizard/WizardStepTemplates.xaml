<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:steps="clr-namespace:UMI.GUI.ViewModels.Wizard.Steps"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels"
    xmlns:wizard="clr-namespace:UMI.GUI.ViewModels.Wizard"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers">

    <DataTemplate DataType="{x:Type steps:WelcomeStepViewModel}">
        <StackPanel Margin="28,24,28,20">

            <TextBlock
                Text="{Binding StepTitle}"
                FontSize="{StaticResource FontSizeLarge}"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushTextPrimary}" />
            <TextBlock
                Text="{Binding StepDescription}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                Margin="0,4,0,20"
                TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding ModeOptions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type steps:ModeOption}">

                        <Border
                            x:Name="ModeBorder"
                            Width="230"
                            Margin="0,0,12,12"
                            Padding="18,16"
                            CornerRadius="{StaticResource RadiusCard}"
                            BorderThickness="2"
                            Cursor="Hand">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource ColorBorder}" />
                            </Border.BorderBrush>

                            <Border.InputBindings>
                                <MouseBinding
                                    MouseAction="LeftClick"
                                    Command="{Binding DataContext.SelectModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                            </Border.InputBindings>

                            <StackPanel>

                                <Path
                                    x:Name="ModeIcon"
                                    Data="{Binding IconPath}"
                                    Fill="{StaticResource BrushTextSecondary}"
                                    Width="36"
                                    Height="36"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12" />

                                <TextBlock
                                    x:Name="ModeTitle"
                                    Text="{Binding Title}"
                                    FontSize="{StaticResource FontSizeMedium}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    Margin="0,0,0,6" />

                                <TextBlock
                                    Text="{Binding Description}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    TextWrapping="Wrap"
                                    LineHeight="18" />
                            </StackPanel>

                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ModeBorder" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource ColorDrone}" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ModeBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource ColorBgCardHover}" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ModeIcon" Property="Fill" Value="{StaticResource BrushDrone}" />
                                <Setter TargetName="ModeTitle" Property="Foreground" Value="{StaticResource BrushDrone}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:WorkbenchStepViewModel}">
        <StackPanel Margin="28,24,28,20">

            <TextBlock
                Text="{Binding StepTitle}"
                FontSize="{StaticResource FontSizeLarge}"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushTextPrimary}" />
            <TextBlock
                Text="{Binding StepDescription}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                Margin="0,4,0,24"
                TextWrapping="Wrap" />

            <Border Style="{StaticResource ToolRowCard}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock
                        Text="{helpers:Localize Wizard_WorkbenchFolder}"
                        Style="{StaticResource GroupHeaderText}"
                        Margin="0,0,0,8" />
                    <TextBlock
                        Text="{helpers:Localize Wizard_WorkbenchFolderDesc}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource BrushTextMuted}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource ToolPathDisplay}" Margin="0,0,8,0">
                            <TextBox
                                Text="{Binding WorkbenchPath, UpdateSourceTrigger=PropertyChanged}"
                                FontFamily="{StaticResource FontMono}"
                                FontSize="{StaticResource FontSizeBody}"
                                Background="Transparent"
                                Foreground="{StaticResource BrushTextPrimary}"
                                CaretBrush="{StaticResource BrushTextPrimary}"
                                BorderThickness="0"
                                VerticalAlignment="Center" />
                        </Border>

                        <Button
                            Grid.Column="1"
                            Command="{Binding BrowseCommand}"
                            Style="{StaticResource ToolBrowseButton}"
                            Content="{helpers:Localize Wizard_BrowseTool}"
                            Cursor="Hand" />
                    </Grid>

                    <TextBlock
                        Text="{Binding PathError}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource BrushErrorText}"
                        Margin="0,6,0,0"
                        Visibility="{Binding PathError, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <TextBlock
                Text="{helpers:Localize Wizard_FolderCreatedHint}"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource BrushTextMuted}"
                Margin="0,10,0,0"
                FontStyle="Italic"
                Opacity="0.8" />

        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:SourceDetectionStepViewModel}">
        <StackPanel Margin="28,24,28,20">

            <TextBlock
                Text="{Binding StepTitle}"
                FontSize="{StaticResource FontSizeLarge}"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushTextPrimary}" />
            <TextBlock
                Text="{Binding StepDescription}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                Margin="0,4,0,20"
                TextWrapping="Wrap" />

            <StackPanel
                HorizontalAlignment="Center"
                Margin="0,16,0,16"
                Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}">

                <Ellipse
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{StaticResource ColorDrone}" Opacity="0.25" />
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                        To="{StaticResource AccentDotPulseScale}"
                                        Duration="0:0:1.6">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                        To="{StaticResource AccentDotPulseScale}"
                                        Duration="0:0:1.6">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="Opacity"
                                        To="{StaticResource AccentDotPulseOpacityMin}"
                                        Duration="0:0:1.6">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    Margin="0,-36,0,0">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{StaticResource ColorDrone}" />
                    </Ellipse.Fill>
                </Ellipse>

                <TextBlock
                    Text="{helpers:Localize Wizard_ConnectCameraPrompt}"
                    FontSize="{StaticResource FontSizeBase}"
                    Foreground="{StaticResource BrushTextSecondary}"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    TextAlignment="Center" />
            </StackPanel>

            <ItemsControl
                ItemsSource="{Binding DetectedSources}"
                Margin="0,0,0,8"
                Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type steps:SourceItem}">
                        <Border
                            Margin="0,0,0,6"
                            Padding="14,12"
                            CornerRadius="{StaticResource RadiusGroup}"
                            BorderThickness="1.5"
                            Cursor="Hand">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
                                    <Setter Property="Background" Value="{StaticResource BrushBgCard}" />
                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushDrone}" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushBgCardHover}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushDrone}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.InputBindings>
                                <MouseBinding
                                    MouseAction="LeftClick"
                                    Command="{Binding DataContext.SelectSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                            </Border.InputBindings>

                            <Grid>
                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Padding="8,5"
                                    CornerRadius="{StaticResource RadiusBadge}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{StaticResource ColorDroneMuted}" />
                                    </Border.Background>
                                    <TextBlock
                                        Text="{Binding DriveLetter}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        FontWeight="Bold"
                                        FontFamily="{StaticResource FontMono}"
                                        Foreground="{StaticResource BrushDrone}" />
                                </Border>

                                <TextBlock
                                    Grid.Column="1"
                                    Grid.Row="0"
                                    Text="{Binding DetectedCamera}"
                                    FontSize="{StaticResource FontSizeBase}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    VerticalAlignment="Bottom"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding DetectedCamera, Converter={StaticResource StringToVisibility}}" />

                                <TextBlock
                                    Grid.Column="1"
                                    Grid.Row="0"
                                    Text="{Binding DisplayName}"
                                    FontSize="{StaticResource FontSizeBase}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    VerticalAlignment="Bottom"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding DetectedCamera, Converter={StaticResource InvertedStringToVisibility}}" />

                                <TextBlock
                                    Grid.Column="1"
                                    Grid.Row="1"
                                    Text="{Binding DisplayName}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding DetectedCamera, Converter={StaticResource StringToVisibility}}" />

                                <StackPanel
                                    Grid.Column="2"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Orientation="Vertical"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">

                                    <Border
                                        Padding="6,3"
                                        CornerRadius="{StaticResource RadiusBadge}"
                                        Margin="0,0,0,3"
                                        Visibility="{Binding DetectedType, Converter={StaticResource StringToVisibility}}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{StaticResource ColorActionMuted}" />
                                        </Border.Background>
                                        <TextBlock
                                            Text="{Binding DetectedType}"
                                            FontSize="{StaticResource FontSizeLabel}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrushAction}" />
                                    </Border>

                                    <Border
                                        Padding="6,3"
                                        CornerRadius="{StaticResource RadiusBadge}"
                                        Visibility="{Binding DetectionMethodLabel, Converter={StaticResource StringToVisibility}}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{StaticResource ColorBadgeGyroBg}" />
                                        </Border.Background>
                                        <TextBlock
                                            Text="{Binding DetectionMethodLabel}"
                                            FontSize="{StaticResource FontSizeLabel}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrushBadgeGyro}" />
                                    </Border>
                                </StackPanel>

                                <Ellipse
                                    Grid.Column="3"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    RenderTransformOrigin="0.5,0.5"
                                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{StaticResource ColorAction}" />
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                        To="{StaticResource AccentDotPulseScale}"
                                                        Duration="0:0:0.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                        To="{StaticResource AccentDotPulseScale}"
                                                        Duration="0:0:0.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Text="{Binding StatusMessage}"
                FontSize="{StaticResource FontSizeSmall}"
                FontFamily="{StaticResource FontMono}"
                Foreground="{StaticResource BrushTextMuted}"
                TextWrapping="Wrap"
                Margin="0,0,0,16"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">

                <Button
                    Command="{Binding ShowAllDrivesCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand"
                    Margin="0,0,16,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowAllDrives}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock
                        Text="{helpers:Localize Wizard_ShowAllDrives}"
                        FontSize="{StaticResource FontSizeCaption}"
                        TextDecorations="Underline"
                        Foreground="{StaticResource BrushTextMuted}" />
                </Button>

                <Button
                    Command="{Binding ManualEntryCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                        </Style>
                    </Button.Style>
                    <TextBlock
                        Text="{helpers:Localize Wizard_EnterManually}"
                        FontSize="{StaticResource FontSizeCaption}"
                        TextDecorations="Underline"
                        Foreground="{StaticResource BrushTextMuted}" />
                </Button>
            </StackPanel>

        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:CameraConfirmStepViewModel}">
        <StackPanel Margin="28,24,28,20">

            <TextBlock
                Text="{Binding StepTitle}"
                FontSize="{StaticResource FontSizeLarge}"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushTextPrimary}" />
            <TextBlock
                Text="{Binding StepDescription}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                Margin="0,4,0,20"
                TextWrapping="Wrap" />

            <Border Style="{StaticResource ToolRowCard}">
                <StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock
                                Text="{helpers:Localize Wizard_CameraTypeLabel}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock
                                Text="{helpers:Localize Wizard_AutoDetected}"
                                FontSize="{StaticResource FontSizeLabel}"
                                Foreground="{StaticResource BrushTextMuted}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            ItemsSource="{Binding AvailableCameraTypes}"
                            SelectedItem="{Binding SelectedCameraType, Mode=TwoWay}"
                            Style="{StaticResource DarkComboBoxStyle}"
                            Padding="8,6" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,7,0,0">
                            <TextBlock
                                Text="{helpers:Localize Wizard_CameraNameLabel}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock
                                Text="{helpers:Localize Wizard_NameYourCamera}"
                                FontSize="{StaticResource FontSizeLabel}"
                                Foreground="{StaticResource BrushTextMuted}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBox
                                Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Padding="8,6"
                                Background="{StaticResource BrushBgSurface}"
                                Foreground="{StaticResource BrushTextPrimary}"
                                CaretBrush="{StaticResource BrushTextPrimary}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1" />

                            <TextBlock
                                Text="{Binding CameraNameError}"
                                FontSize="{StaticResource FontSizeLabel}"
                                Foreground="{StaticResource BrushErrorText}"
                                Margin="0,3,0,0"
                                TextWrapping="Wrap"
                                Visibility="{Binding CameraNameError, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,7,0,0">
                            <TextBlock
                                Text="{helpers:Localize Wizard_ImportFolderLabel}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock
                                Text="{helpers:Localize Wizard_ImportFolderHint}"
                                FontSize="{StaticResource FontSizeLabel}"
                                Foreground="{StaticResource BrushTextMuted}" />
                        </StackPanel>
                        <TextBox
                            Grid.Column="1"
                            Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="{StaticResource FontSizeSmall}"
                            FontFamily="{StaticResource FontMono}"
                            Padding="8,6"
                            Background="{StaticResource BrushBgSurface}"
                            Foreground="{StaticResource BrushTextPrimary}"
                            CaretBrush="{StaticResource BrushTextPrimary}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="1" />
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type steps:MoreCamerasStepViewModel}">
        <StackPanel Margin="28,24,28,20">

            <TextBlock
                Text="{Binding StepTitle}"
                FontSize="{StaticResource FontSizeLarge}"
                FontWeight="SemiBold"
                Foreground="{StaticResource BrushTextPrimary}" />
            <TextBlock
                Text="{Binding StepDescription}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                Margin="0,4,0,20"
                TextWrapping="Wrap" />

            <TextBlock
                Text="{helpers:Localize Wizard_RegisteredCameras}"
                Style="{StaticResource GroupHeaderText}"
                Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding RegisteredCameras}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type wizard:WizardCameraEntry}">
                        <Border
                            Margin="0,0,0,6"
                            Padding="12,10"
                            CornerRadius="{StaticResource RadiusGroup}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BrushBorderSubtle}">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontSize="{StaticResource FontSizeBase}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrushTextPrimary}" />
                                        <Border
                                            Margin="8,0,0,0"
                                            Padding="6,2"
                                            CornerRadius="{StaticResource RadiusBadge}"
                                            VerticalAlignment="Center">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource ColorDroneMuted}" />
                                            </Border.Background>
                                            <TextBlock
                                                Text="{Binding CameraType}"
                                                FontSize="{StaticResource FontSizeLabel}"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource BrushDrone}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Text="{Binding CameraId}"
                                        FontSize="{StaticResource FontSizeBody}"
                                        FontFamily="{StaticResource FontMono}"
                                        Foreground="{StaticResource BrushTextMuted}"
                                        Margin="0,2,0,0" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Command="{Binding DataContext.RemoveCameraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CardDeleteButton}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Text="{helpers:Localize Wizard_NoCamerasYet}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                FontStyle="Italic"
                Margin="0,0,0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RegisteredCameras.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button
                Command="{Binding AddMoreCommand}"
                HorizontalAlignment="Left"
                Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
                        <Setter Property="Foreground" Value="{StaticResource BrushDrone}" />
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <Path
                        Data="M12,4 V20 M4,12 H20"
                        Stroke="{StaticResource BrushDrone}"
                        StrokeThickness="2"
                        Width="12"
                        Height="12"
                        Stretch="Uniform"
                        VerticalAlignment="Center"
                        Margin="0,0,7,0" />
                    <TextBlock
                        Text="{helpers:Localize Wizard_AddAnotherCamera}"
                        FontSize="{StaticResource FontSizeSmall}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushDrone}"
                        VerticalAlignment="Center" />
