<UserControl
    x:Class="UMI.GUI.Views.DevicesTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels"
    xmlns:behaviors="clr-namespace:UMI.GUI.Behaviors"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers">

    <UserControl.Resources>

        <DataTemplate x:Key="DeviceEntryTemplate" DataType="{x:Type vm:DeviceEntryViewModel}">
            <StackPanel Margin="0,0,0,8">

                <Border Style="{StaticResource CameraCard}" Margin="0">
                    <StackPanel>

                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Tag="DragHandle"
                                Background="Transparent"
                                MinWidth="20"
                                MinHeight="30"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Cursor="SizeAll"
                                ToolTip="{helpers:Localize DevicesTab_DragTooltip}"
                                Visibility="{Binding IsReorderable, Converter={StaticResource BoolToVisibility}}">

                                <StackPanel
                                    Tag="DragHandle"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                    <Setter Property="Opacity" Value="{StaticResource DragGripHoverOpacity}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel Tag="DragHandle" Orientation="Vertical" Margin="0,0,2,0">
                                        <Ellipse Tag="DragHandle" Width="3" Height="3" Margin="0,0,0,2" Fill="{StaticResource BrushTextMuted}" />
                                        <Ellipse Tag="DragHandle" Width="3" Height="3" Margin="0,0,0,2" Fill="{StaticResource BrushTextMuted}" />
                                        <Ellipse Tag="DragHandle" Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" />
                                    </StackPanel>
                                    <StackPanel Tag="DragHandle" Orientation="Vertical">
                                        <Ellipse Tag="DragHandle" Width="3" Height="3" Margin="0,0,0,2" Fill="{StaticResource BrushTextMuted}" />
                                        <Ellipse Tag="DragHandle" Width="3" Height="3" Margin="0,0,0,2" Fill="{StaticResource BrushTextMuted}" />
                                        <Ellipse Tag="DragHandle" Width="3" Height="3" Fill="{StaticResource BrushTextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid
                                Grid.Column="1"
                                Cursor="Hand"
                                Background="Transparent"
                                VerticalAlignment="Center">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandCommand}" />
                                </Grid.InputBindings>
                                <TextBlock
                                    Text="{Binding Label}"
                                    FontSize="{StaticResource FontSizeBase}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <Ellipse
                                Grid.Column="2"
                                ToolTip="{Binding ConnectedDriveLetter, StringFormat='Connected ({0})'}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource CardConnectedIndicator}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCardConnected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <Border
                                Grid.Column="3"
                                CornerRadius="{StaticResource RadiusBadge}"
                                Padding="7,2"
                                Margin="8,0,6,0"
                                VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BrushBubbleInactive}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFloating}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushBadgeGyroBg}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="{StaticResource FontSizeLabel}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{helpers:Localize DevicesTab_Fixed}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFloating}" Value="True">
                                                    <Setter Property="Text" Value="{helpers:Localize DevicesTab_Floating}" />
                                                    <Setter Property="Foreground" Value="{StaticResource BrushBadgeGyro}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <Border
                                Grid.Column="4"
                                CornerRadius="{StaticResource RadiusBadge}"
                                Background="{StaticResource BrushDroneMuted}"
                                Padding="6,2"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsFixed, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Text="{Binding CameraId}"
                                    FontSize="{StaticResource FontSizeLabel}"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource BrushDrone}" />
                            </Border>

                            <ToggleButton
                                x:Name="HistoryToggle"
                                Grid.Column="5"
                                IsChecked="{Binding IsHistoryVisible, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="4,0,2,0"
                                Cursor="Hand"
                                ToolTip="{helpers:Localize DevicesTab_HistoryTooltip}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border
                                                        x:Name="HistBtnBorder"
                                                        Background="Transparent"
                                                        CornerRadius="4"
                                                        Padding="4,3">

                                                        <Path
                                                            x:Name="HistIcon"
                                                            Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M12,20 C7.59,20 4,16.41 4,12 C4,7.59 7.59,4 12,4 C16.41,4 20,7.59 20,12 C20,16.41 16.41,20 12,20 Z M12.5,7 H11 V13 L16.25,16.15 L17,14.92 L12.5,12.25 Z"
                                                            Fill="{StaticResource BrushTextMuted}"
                                                            Width="14"
                                                            Height="14"
                                                            Stretch="Uniform" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="HistIcon" Property="Fill" Value="{StaticResource BrushTextSecondary}" />
                                                            <Setter TargetName="HistBtnBorder" Property="Background" Value="{StaticResource BrushBgSurface}" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="HistIcon" Property="Fill" Value="{StaticResource BrushDrone}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding DeviceType}" Value="SdCard">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Popup
                                Grid.Column="5"
                                IsOpen="{Binding IsHistoryVisible, Mode=TwoWay}"
                                StaysOpen="False"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=HistoryToggle}"
                                AllowsTransparency="True"
                                PopupAnimation="Fade">
                                <Border
                                    Background="{StaticResource BrushBgCard}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}"
                                    Padding="14,12"
                                    MinWidth="320"
                                    MaxWidth="420">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            Color="{StaticResource ColorShadow}"
                                            BlurRadius="{StaticResource ShadowPopupBlurRadius}"
                                            ShadowDepth="{StaticResource ShadowPopupShadowDepth}"
                                            Opacity="{StaticResource ShadowPopupOpacity}"
                                            Direction="270" />
                                    </Border.Effect>
                                    <StackPanel>

                                        <TextBlock
                                            FontSize="{StaticResource FontSizeSmall}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrushTextPrimary}"
                                            Margin="0,0,0,4">
                                            <Run Text="{helpers:Localize DevicesTab_ImportHistory}" />
                                            <Run Text=" — " Foreground="{StaticResource BrushTextMuted}" />
                                            <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource BrushTextMuted}" />
                                        </TextBlock>

                                        <TextBlock
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Margin="0,0,0,8">
                                            <Run Text="{Binding TotalImportCount, Mode=OneWay, StringFormat='{}{0} imports total'}" />
                                        </TextBlock>

                                        <Border
                                            Height="1"
                                            Background="{StaticResource BrushBorderSubtle}"
                                            Margin="0,0,0,8" />

                                        <TextBlock
                                            Text="{helpers:Localize DevicesTab_NoImports}"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            FontStyle="Italic"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Margin="0,4,0,4"
                                            Visibility="{Binding HasUsageHistory, Converter={StaticResource InvertedBoolToVisibility}}" />

                                        <StackPanel Visibility="{Binding HasUsageHistory, Converter={StaticResource BoolToVisibility}}">

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="45" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{helpers:Localize DevicesTab_Camera}"
                                                    FontSize="{StaticResource FontSizeLabel}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource BrushTextMuted}"
                                                    Opacity="{StaticResource OpacityHint}" />
                                                <TextBlock Grid.Column="1" Text="{helpers:Localize DevicesTab_Imports}"
                                                    FontSize="{StaticResource FontSizeLabel}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource BrushTextMuted}"
                                                    Opacity="{StaticResource OpacityHint}"
                                                    TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{helpers:Localize DevicesTab_Percent}"
                                                    FontSize="{StaticResource FontSizeLabel}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource BrushTextMuted}"
                                                    Opacity="{StaticResource OpacityHint}"
                                                    TextAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{helpers:Localize DevicesTab_LastUsed}"
                                                    FontSize="{StaticResource FontSizeLabel}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource BrushTextMuted}"
                                                    Opacity="{StaticResource OpacityHint}"
                                                    TextAlignment="Right" />
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding UsageEntries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="60" />
                                                                <ColumnDefinition Width="45" />
                                                                <ColumnDefinition Width="80" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding CameraId}"
                                                                FontSize="{StaticResource FontSizeCaption}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource BrushTextPrimary}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ImportCount}"
                                                                FontSize="{StaticResource FontSizeCaption}"
                                                                FontFamily="{StaticResource FontMono}"
                                                                Foreground="{StaticResource BrushTextSecondary}"
                                                                TextAlignment="Right" />
                                                            <TextBlock Grid.Column="2" Text="{Binding PercentDisplay}"
                                                                FontSize="{StaticResource FontSizeCaption}"
                                                                FontFamily="{StaticResource FontMono}"
                                                                Foreground="{StaticResource BrushTextMuted}"
                                                                TextAlignment="Right" />
                                                            <TextBlock Grid.Column="3" Text="{Binding LastUsed}"
                                                                FontSize="{StaticResource FontSizeCaption}"
                                                                FontFamily="{StaticResource FontMono}"
                                                                Foreground="{StaticResource BrushTextMuted}"
                                                                TextAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <ToggleButton
                                Grid.Column="6"
                                Style="{StaticResource ToggleSwitchCompactStyle}"
                                IsChecked="{Binding IsCameraEnabled, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="4,0,6,0"
                                ToolTip="{helpers:Localize DevicesTab_EnableTooltip}" />

                            <StackPanel
                                Grid.Column="7"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                                <Button
                                    Style="{StaticResource CardEditVisibleButton}"
                                    Command="{Binding StartEditCommand}"
                                    ToolTip="{helpers:Localize DevicesTab_EditTooltip}"
                                    Margin="0,0,2,0">

                                    <Path
                                        Data="{StaticResource GeoPencil}"
                                        Stroke="{StaticResource BrushTextMuted}"
                                        StrokeThickness="1.5"
                                        Fill="Transparent"
                                        Width="13"
                                        Height="13"
                                        Stretch="Uniform" />
                                </Button>

                                <Button
                                    Style="{StaticResource CardEditingVisibleButton}"
                                    Command="{Binding SaveCommand}"
                                    ToolTip="{helpers:Localize DevicesTab_SaveTooltip}"
                                    Margin="0,0,2,0">

                                    <Path
                                        Data="{StaticResource GeoCheckmark}"
                                        Stroke="{StaticResource BrushBadgeGps}"
                                        StrokeThickness="2"
                                        Fill="Transparent"
                                        Width="13"
                                        Height="11"
                                        Stretch="Uniform" />
                                </Button>

                                <Button
                                    Style="{StaticResource CardEditingVisibleButton}"
                                    Command="{Binding CancelCommand}"
                                    ToolTip="{helpers:Localize DevicesTab_CancelTooltip}"
                                    Margin="0,0,2,0">

                                    <Path
                                        Data="{StaticResource GeoXMark}"
                                        Stroke="{StaticResource BrushTextMuted}"
                                        StrokeThickness="1.8"
                                        Fill="Transparent"
                                        Width="10"
                                        Height="10"
                                        Stretch="Uniform" />
                                </Button>

                                <Button
                                    Style="{StaticResource CardEditingDeleteButton}"
                                    Command="{Binding DeleteCommand}"
                                    ToolTip="{helpers:Localize DevicesTab_DeleteTooltip}"
                                    Margin="0,0,2,0" />

                            </StackPanel>

                            <Button
                                Grid.Column="8"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Command="{Binding ToggleExpandCommand}"
                                ToolTip="{helpers:Localize DevicesTab_ExpandTooltip}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" CornerRadius="4">

                                                        <Path
                                                            x:Name="Chevron"
                                                            Stroke="{StaticResource BrushTextMuted}"
                                                            StrokeThickness="1.8"
                                                            Width="10"
                                                            Height="6"
                                                            Stretch="Uniform"
                                                            Fill="Transparent">
                                                            <Path.Style>
                                                                <Style TargetType="Path">

                                                                    <Setter Property="Data" Value="M4,8 L12,16 L20,8" />
                                                                    <Style.Triggers>

                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                            <Setter Property="Data" Value="M8,4 L16,12 L8,20" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </Grid>

                        <StackPanel
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                            Margin="2,0,2,2"
                            Focusable="True"
                            MouseDown="ExpandedPanel_MouseDown"
                            PreviewKeyDown="ExpandedPanel_PreviewKeyDown">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsCameraDisabled}" Value="True">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border Style="{StaticResource CardDivider}" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{helpers:Localize DevicesTab_Label}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding EditLabel}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    VerticalAlignment="Center"
                                    Padding="0,5"
                                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />

                                <TextBox
                                    Grid.Column="1"
                                    Text="{Binding EditLabel, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Padding="8,5"
                                    Background="{StaticResource BrushBgSurface}"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    CaretBrush="{StaticResource BrushTextPrimary}"
                                    BorderBrush="{StaticResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{helpers:Localize DevicesTab_Camera}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding EditCameraId}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    VerticalAlignment="Center"
                                    Padding="0,5"
                                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />

                                <ComboBox
                                    Grid.Column="1"
                                    ItemsSource="{Binding AvailableCameraIds}"
                                    SelectedItem="{Binding EditCameraId, Mode=TwoWay}"
                                    Style="{StaticResource DarkComboBoxStyle}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="">
                                                                <Setter Property="Text" Value="{helpers:Localize DevicesTab_NoCameraFloating}" />
                                                                <Setter Property="Foreground" Value="{StaticResource BrushBadgeGyro}" />
                                                                <Setter Property="FontStyle" Value="Italic" />
                                                                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <StackPanel Margin="0,0,0,8">

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                            Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        Text="{helpers:Localize DevicesTab_DeviceIdLabel}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Foreground="{StaticResource BrushTextMuted}"
                                        Width="100" />
                                    <TextBlock
                                        Text="{Binding Key}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        FontFamily="{StaticResource FontMono}"
                                        Foreground="{StaticResource BrushTextMuted}" />
                                </StackPanel>

                                <Grid Margin="0,0,0,4"
                                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{helpers:Localize DevicesTab_DeviceIdLabel}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Foreground="{StaticResource BrushTextMuted}"
                                        VerticalAlignment="Center" />

                                    <TextBox
                                        Grid.Column="1"
                                        Text="{Binding EditKey, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        FontFamily="{StaticResource FontMono}"
                                        Padding="8,4"
                                        Background="{StaticResource BrushBgSurface}"
                                        Foreground="{StaticResource BrushTextPrimary}"
                                        CaretBrush="{StaticResource BrushTextPrimary}"
                                        BorderBrush="{StaticResource BrushBorderSubtle}"
                                        BorderThickness="1">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="IsReadOnly" Value="True" />
                                                <Setter Property="Opacity" Value="0.65" />
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding CanReLearn}" Value="True">
                                                        <Setter Property="IsReadOnly" Value="False" />
                                                        <Setter Property="Opacity" Value="1.0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding ReLearnVsnCommand}"
                                        Cursor="Hand"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding CanReLearn, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{helpers:Localize DevicesTab_ReadVsnTooltip}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                x:Name="ReLearnBorder"
                                                                CornerRadius="4"
                                                                Padding="8,4"
                                                                BorderThickness="1"
                                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                                Background="Transparent">
                                                                <StackPanel Orientation="Horizontal">

                                                                    <Path
                                                                        x:Name="ReLearnIcon"
                                                                        Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4.01,7.58 4,12 C4,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 H17.65 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 H20 V4 L17.65,6.35 Z"
                                                                        Fill="{StaticResource BrushTextMuted}"
                                                                        Width="12"
                                                                        Height="12"
                                                                        Stretch="Uniform"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,5,0" />
                                                                    <TextBlock
                                                                        x:Name="ReLearnText"
                                                                        Text="{helpers:Localize DevicesTab_Relearn}"
                                                                        FontSize="{StaticResource FontSizeLabel}"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{StaticResource BrushTextMuted}"
                                                                        VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ReLearnBorder" Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                                                    <Setter TargetName="ReLearnText" Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                                    <Setter TargetName="ReLearnIcon" Property="Fill" Value="{StaticResource BrushTextSecondary}" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="ReLearnBorder" Property="Opacity" Value="0.4" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <TextBlock
                                    Text="{Binding ReLearnMessage}"
                                    FontSize="{StaticResource FontSizeLabel}"
                                    FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource BrushBadgeGps}"
                                    Margin="100,0,0,4"
                                    Visibility="{Binding ReLearnMessage, Converter={StaticResource StringToVisibility}}" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                            Visibility="{Binding DiskSerial, Converter={StaticResource StringToVisibility}}">
                                    <TextBlock
                                        Text="{helpers:Localize DevicesTab_DiskSerial}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Foreground="{StaticResource BrushTextMuted}"
                                        Width="100" />
                                    <TextBlock
                                        Text="{Binding DiskSerial}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        FontFamily="{StaticResource FontMono}"
                                        Foreground="{StaticResource BrushTextMuted}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding SizeDisplay, Converter={StaticResource StringToVisibility}}">
                                    <TextBlock
                                        Text="{helpers:Localize DevicesTab_Capacity}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Foreground="{StaticResource BrushTextMuted}"
                                        Width="100" />
                                    <TextBlock
                                        Text="{Binding SizeDisplay}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Foreground="{StaticResource BrushTextMuted}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource CardDivider}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding SaveStatus}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        FontFamily="{StaticResource FontMono}"
                                        Foreground="{StaticResource BrushBadgeGps}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding SaveStatus, Converter={StaticResource StringToVisibility}}" />

                                    <Button
                                        Grid.Column="1"
                                        Content="{helpers:Localize DevicesTab_Cancel}"
                                        Command="{Binding CancelCommand}"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource CardNeutralButton}" />

                                    <Button
                                        Grid.Column="2"
                                        Content="{helpers:Localize DevicesTab_Save}"
                                        Command="{Binding SaveCommand}"
                                        Style="{StaticResource CardSaveButton}" />
                                </Grid>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer Padding="24,20,24,20">
        <StackPanel>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        Text="{helpers:Localize DevicesTab_Title}"
                        FontSize="{StaticResource FontSizeMedium}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock
                        Text="{helpers:Localize DevicesTab_Desc}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource BrushTextMuted}"
                        Margin="0,4,0,0"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Command="{Binding AddDeviceCommand}"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource EditCamLinkButton}">
                            <Setter Property="Padding" Value="14,7" />
                        </Style>
                    </Button.Style>
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">

                            <Path
                                Data="M12,4 V20 M4,12 H20"
                                Stroke="{StaticResource BrushDrone}"
                                StrokeThickness="2"
                                Width="12"
                                Height="12"
                                Stretch="Uniform"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Opacity="{StaticResource OpacityHover}" />
                            <TextBlock
                                Text="{helpers:Localize DevicesTab_AddDevice}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrushDrone}"
                                Opacity="{StaticResource OpacityHover}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>

            <Border
                Margin="0,0,0,16"
                Padding="16,12"
                CornerRadius="{StaticResource RadiusGroup}"
                BorderThickness="1"
                Visibility="{Binding ShowDeleteConfirm, Converter={StaticResource BoolToVisibility}}">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource ColorErrorBg}" />
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{StaticResource ColorErrorBorder}" />
                </Border.BorderBrush>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding DeleteConfirmLabel}"
                        FontSize="{StaticResource FontSizeSmall}"
                        Foreground="{StaticResource BrushErrorText}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Grid.Column="1"
                        Content="{helpers:Localize DevicesTab_Cancel}"
                        Command="{Binding CancelDeleteCommand}"
                        Margin="12,0,8,0"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="CancelBorder"
                                                CornerRadius="5"
                                                Padding="12,5"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                                Background="Transparent">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CancelBorder" Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Content="{helpers:Localize DevicesTab_Remove}"
                        Command="{Binding ConfirmDeleteCommand}"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="ConfirmBorder"
                                                CornerRadius="5"
                                                Padding="12,5">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{StaticResource ColorErrorBorder}" />
                                                </Border.Background>
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ConfirmBorder" Property="Opacity" Value="0.8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource BrushErrorText}" />
                                <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Margin="0,0,0,24">

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="{StaticResource OpacityHint}">
                        <Path
                            Data="M4,4 C4,2.9 4.9,2 6,2 H14 L20,8 V20 C20,21.1 19.1,22 18,22 H6 C4.9,22 4,21.1 4,20 V4 Z M14,2 V8 H20"
                            Fill="{StaticResource BrushTextMuted}"
                            Stretch="Uniform" />
                    </Viewbox>

                    <TextBlock
                        Grid.Column="1"
                        Text="{helpers:Localize DevicesTab_SdCards}"
                        Style="{StaticResource GroupHeaderText}"
                        VerticalAlignment="Center" />

                    <Border Grid.Column="2" />

                    <Border
                        Grid.Column="3"
                        CornerRadius="{StaticResource RadiusGroup}"
                        Padding="7,2"
                        VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                        </Border.Background>
                        <TextBlock
                            Text="{Binding SdCardCount}"
                            FontSize="{StaticResource FontSizeCaption}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextMuted}" />
                    </Border>
                </Grid>

                <Border Height="1" Margin="0,0,0,10" Opacity="0.4" Background="{StaticResource BrushDrone}" />

                <ItemsControl
                    ItemsSource="{Binding SdCards}"
                    ItemTemplate="{StaticResource DeviceEntryTemplate}"
                    behaviors:DragDropReorderBehavior.IsEnabled="True"
                    behaviors:DragDropReorderBehavior.DropCallback="{Binding ReorderSdCardsCommand}" />

                <TextBlock
                    Text="{helpers:Localize DevicesTab_NoSdCards}"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushTextMuted}"
                    FontStyle="Italic"
                    Margin="4,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SdCardCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>

            <StackPanel Margin="0,0,0,24">

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="{StaticResource OpacityHint}">
                        <Path
                            Data="M12,2 L12,14 M8,10 L12,14 L16,10 M5,20 C5,18.9 5.9,18 7,18 H17 C18.1,18 19,18.9 19,20 V22 H5 V20 Z"
                            Stroke="{StaticResource BrushTextMuted}"
                            StrokeThickness="1.5"
                            Fill="Transparent"
                            Stretch="Uniform" />
                    </Viewbox>

                    <TextBlock
                        Grid.Column="1"
                        Text="{helpers:Localize DevicesTab_MtpDevices}"
                        Style="{StaticResource GroupHeaderText}"
                        VerticalAlignment="Center" />

                    <Border Grid.Column="2" />

                    <Border
                        Grid.Column="3"
                        CornerRadius="{StaticResource RadiusGroup}"
                        Padding="7,2"
                        VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                        </Border.Background>
                        <TextBlock
                            Text="{Binding MtpDeviceCount}"
                            FontSize="{StaticResource FontSizeCaption}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextMuted}" />
                    </Border>
                </Grid>

                <Border Height="1" Margin="0,0,0,10" Opacity="0.4" Background="{StaticResource BrushMirrorless}" />

                <ItemsControl
                    ItemsSource="{Binding MtpDevices}"
                    ItemTemplate="{StaticResource DeviceEntryTemplate}"
                    behaviors:DragDropReorderBehavior.IsEnabled="True"
                    behaviors:DragDropReorderBehavior.DropCallback="{Binding ReorderMtpDevicesCommand}" />

                <TextBlock
                    Text="{helpers:Localize DevicesTab_NoMtpDevices}"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushTextMuted}"
                    FontStyle="Italic"
                    Margin="4,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MtpDeviceCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>

            <StackPanel Margin="0,0,0,24">

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="{StaticResource OpacityHint}">
                        <Path
                            Data="M3,7 C3,5.9 3.9,5 5,5 H10 L12,7 H19 C20.1,7 21,7.9 21,9 V19 C21,20.1 20.1,21 19,21 H5 C3.9,21 3,20.1 3,19 V7 Z"
                            Fill="{StaticResource BrushTextMuted}"
                            Stretch="Uniform" />
                    </Viewbox>

                    <TextBlock
                        Grid.Column="1"
                        Text="{helpers:Localize DevicesTab_FixedPaths}"
                        Style="{StaticResource GroupHeaderText}"
                        VerticalAlignment="Center" />

                    <Border Grid.Column="2" />

                    <Border
                        Grid.Column="3"
                        CornerRadius="{StaticResource RadiusGroup}"
                        Padding="7,2"
                        VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource ColorBgCard}" />
                        </Border.Background>
                        <TextBlock
                            Text="{Binding FixedPathCount}"
                            FontSize="{StaticResource FontSizeCaption}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextMuted}" />
                    </Border>
                </Grid>

                <Border Height="1" Margin="0,0,0,10" Opacity="0.4" Background="{StaticResource BrushAction}" />

                <ItemsControl
                    ItemsSource="{Binding FixedPaths}"
                    ItemTemplate="{StaticResource DeviceEntryTemplate}" />

                <TextBlock
                    Text="{helpers:Localize DevicesTab_NoFixedPaths}"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushTextMuted}"
                    FontStyle="Italic"
                    Margin="4,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FixedPathCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>

            <Border
                Margin="0,16,0,0"
                Padding="12,6"
                CornerRadius="{StaticResource RadiusButton}"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource ColorBadgeGpsBg}" />
                </Border.Background>
                <TextBlock
                    Text="{Binding StatusMessage}"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushBadgeGps}"
                    FontFamily="{StaticResource FontMono}" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
