<UserControl
    x:Class="UMI.GUI.Views.BurstVisualizerV2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:UMI.GUI.Helpers"
    xmlns:vm="clr-namespace:UMI.GUI.ViewModels"
    xmlns:controls="clr-namespace:UMI.GUI.Views.Controls">

    <Border
        Background="{StaticResource BrushBgCard}"
        CornerRadius="{StaticResource RadiusCard}"
        BorderBrush="{StaticResource BrushBorderSubtle}"
        BorderThickness="1"
        Padding="16,12">

        <StackPanel>

            <TextBlock
                Text="{helpers:Localize BurstVis_Title}"
                Style="{StaticResource BurstSectionLabel}" />

            <TextBlock
                Text="{Binding EvalSummary}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextSecondary}"
                Margin="0,0,0,10"
                Visibility="{Binding EvalSummary, Converter={StaticResource StringToVisibility}}" />

            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">

                <Button
                    Content="{helpers:Localize BurstVis_Browse}"
                    Command="{Binding BrowseFolderCommand}"
                    Style="{StaticResource BurstOutlineButton}"
                    Margin="0,0,6,4" />

                <TextBox
                    Text="{Binding FolderPath, Mode=OneWay}"
                    IsReadOnly="True"
                    MinWidth="200"
                    MaxWidth="400"
                    VerticalAlignment="Center"
                    Margin="0,0,6,4"
                    Background="{StaticResource BrushBgSurface}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="1"
                    Foreground="{StaticResource BrushTextSecondary}"
                    FontSize="{StaticResource FontSizeSmall}"
                    Padding="6,4" />

                <Button
                    Content="{helpers:Localize BurstVis_Load}"
                    Command="{Binding LoadFolderCommand}"
                    Style="{StaticResource BurstOutlineButton}"
                    Margin="0,0,16,4" />

                <TextBlock
                    Text="{helpers:Localize BurstVis_Profile}"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushTextSecondary}"
                    Margin="0,0,6,4" />

                <ComboBox
                    ItemsSource="{Binding AvailableProfiles}"
                    SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                    Style="{StaticResource BurstComboBoxStyle}"
                    MinWidth="160"
                    VerticalAlignment="Center"
                    Margin="0,0,16,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock
                    Text="{helpers:Localize BurstVis_Size}"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushTextSecondary}"
                    Margin="0,0,6,4" />

                <Slider
                    Value="{Binding ThumbnailSize, Mode=TwoWay}"
                    Minimum="64"
                    Maximum="256"
                    Width="120"
                    VerticalAlignment="Center"
                    Margin="0,0,16,4" />

                <ToggleButton
                    Content="{helpers:Localize BurstVis_SelectPhotos}"
                    IsChecked="{Binding IsSelectionMode, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    Margin="0,0,0,4"
                    Cursor="Hand"
                    ToolTip="{helpers:Localize BurstVis_SelectPhotosTooltip}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">

                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource RadiusButton}"
                                            Padding="{TemplateBinding Padding}">
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Background" Value="{StaticResource BrushBgSurface}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="12,6" />
                            <Style.Triggers>

                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BrushBadgeBurst}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBadgeBurst}" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushBgCard}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource BrushBadgeBurst}"
                    Margin="8,0,6,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <TextBlock.Text>
                        <Binding Path="SelectedCount" StringFormat="{}{0} selected" />
                    </TextBlock.Text>
                </TextBlock>

                <Button
                    Content="{helpers:Localize BurstVis_GeneratePreset}"
                    Command="{Binding GeneratePresetCommand}"
                    Margin="0,0,6,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BurstOutlineButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button
                    Content="{helpers:Localize BurstVis_Clear}"
                    Command="{Binding ClearSelectionCommand}"
                    Margin="0,0,6,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BurstOutlineButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </WrapPanel>

            <TextBlock
                Text="{Binding LoadStatus}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushTextMuted}"
                Margin="0,0,0,4"
                Visibility="{Binding LoadStatus, Converter={StaticResource StringToVisibility}}" />

            <ProgressBar
                IsIndeterminate="True"
                Height="3"
                Margin="0,0,0,8"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock
                Text="{Binding StatusMessage}"
                FontSize="{StaticResource FontSizeSmall}"
                Foreground="{StaticResource BrushBadgeGps}"
                Margin="0,0,0,8"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

            <Border
                Margin="0,0,0,8"
                Background="{StaticResource BrushBgSurface}"
                CornerRadius="{StaticResource RadiusGroup}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1"
                Padding="12,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,8"
                        DataContext="{Binding SelectedProfile}">

                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="{StaticResource FontSizeSmall}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextPrimary}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />

                        <Button
                            Content="{helpers:Localize BurstVis_Edit}"
                            Command="{Binding EditCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BurstOutlineButton}">
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button
                            Content="{helpers:Localize BurstVis_Save}"
                            Command="{Binding SaveCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CardSaveButton}">
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button
                            Content="{helpers:Localize BurstVis_Cancel}"
                            Command="{Binding CancelCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CardNeutralButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock
                            Text="{Binding SaveStatus}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource BrushBadgeGps}"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            Visibility="{Binding SaveStatus, Converter={StaticResource StringToVisibility}}" />

                    </StackPanel>

                    <controls:RuleEditorPanel DataContext="{Binding SelectedProfile}" />

                </StackPanel>
            </Border>

            <ScrollViewer
                MaxHeight="600"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <ItemsControl
                    ItemsSource="{Binding GridItems}"
                    Tag="{Binding ThumbnailSize}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThumbnailItemViewModel}">
                            <Border
                                Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                BorderBrush="{Binding SequenceIndex, Converter={StaticResource SeqIndexToBrush}}"
                                CornerRadius="4"
                                Margin="2"
                                Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                <Setter Property="BorderThickness" Value="3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Border.InputBindings>
                                    <MouseBinding
                                        MouseAction="LeftClick"
                                        Command="{Binding ClickCommand}" />
                                </Border.InputBindings>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ClipToBounds="True">
                                        <Image
                                            Source="{Binding ThumbnailImage}"
                                            Stretch="UniformToFill"
                                            RenderOptions.BitmapScalingMode="HighQuality" />

                                        <Border
                                            VerticalAlignment="Top"
                                            Height="4"
                                            IsHitTestVisible="False"
                                            Background="{StaticResource BrushBadgePost}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Border IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource ColorBg}" Opacity="{StaticResource OpacityMuted}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path
                                                    Data="M9,16.2L4.8,12l-1.4,1.4L9,19L21,7l-1.4-1.4z"
                                                    Fill="{StaticResource BrushWhite}"
                                                    Stretch="Uniform" />
                                            </Viewbox>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Margin="2,2,2,0">

                                        <TextBlock
                                            Text="{Binding FileName}"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{StaticResource BrushTextSecondary}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding FileName}" />

                                        <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMuted}">
                                            <Run Text="{Binding DisplayTime, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding DisplayIso, Mode=OneWay}" />
                                        </TextBlock>

                                        <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource BrushTextMuted}">
                                            <Run Text="{Binding DisplayExposure, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding DisplayAperture, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding DisplayFocus, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>

            <TextBlock
                Text="{helpers:Localize BurstVis_SelectionHint}"
                Foreground="{StaticResource BrushTextMuted}"
                FontSize="{StaticResource FontSizeSmall}"
                TextWrapping="Wrap"
                Margin="0,8,0,0"
                Visibility="{Binding ShowSelectionHint, Converter={StaticResource BoolToVisibility}}" />

            <Border
                Margin="0,12,0,0"
                Background="{StaticResource BrushBgSurface}"
                CornerRadius="{StaticResource RadiusGroup}"
                BorderBrush="{StaticResource BrushBadgeBurst}"
                BorderThickness="1"
                Padding="12,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPresetPreviewVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <TextBlock
                        Text="{helpers:Localize BurstVis_PresetPreview}"
                        Style="{StaticResource BurstSectionLabel}"
                        Margin="0,0,0,6" />

                    <ItemsControl
                        ItemsSource="{Binding GeneratedPreset.ExplanationLines}"
                        Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource BrushTextSecondary}"
                                    Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal">
                        <Button
                            Content="{helpers:Localize BurstVis_AcceptSave}"
                            Command="{Binding AcceptPresetCommand}"
                            Style="{StaticResource BurstOutlineButton}"
                            Foreground="{StaticResource BrushBadgeGps}"
                            Margin="0,0,8,0" />

                        <Button
                            Content="{helpers:Localize BurstVis_Discard}"
                            Style="{StaticResource BurstOutlineButton}"
                            Foreground="{StaticResource BrushTextMuted}"
                            Command="{Binding DiscardPresetCommand}" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </Border>

</UserControl>
