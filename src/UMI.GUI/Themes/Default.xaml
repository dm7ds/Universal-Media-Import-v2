    <Style x:Key="HeaderTabButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,0,0,4" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />

                            <RowDefinition Height="2" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="TabLabel"
                            Grid.Row="0"
                            Text="{TemplateBinding Content}"
                            FontSize="{StaticResource FontSizeBase}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrushTextMuted}"
                            VerticalAlignment="Center" />

                        <Border
                            x:Name="AccentLine"
                            Grid.Row="1"
                            Background="Transparent"
                            CornerRadius="1" />
                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                            <Setter TargetName="AccentLine" Property="Background" Value="{StaticResource BrushDrone}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Tag" Value="Inactive" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Tag" Value="Active" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

