        <Setter Property="Padding" Value="20,16" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource ColorHeaderGradientStart}" Offset="0" />
                    <GradientStop Color="{StaticResource ColorHeaderGradientEnd}" Offset="1" />
