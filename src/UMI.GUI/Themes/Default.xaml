    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="AccentDotPulseScale">1.45</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="AccentDotPulseOpacityMin">0.55</System:Double>

    <Style x:Key="HeaderAccentDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Fill" Value="{StaticResource BrushDrone}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Storyboard x:Key="AccentDotPulse">
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                    To="{StaticResource AccentDotPulseScale}"
                    Duration="0:0:1.6"
                    RepeatBehavior="Forever"
                    AutoReverse="True"
                    FillBehavior="Stop">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    To="{StaticResource AccentDotPulseScale}"
                    Duration="0:0:1.6"
                    RepeatBehavior="Forever"
                    AutoReverse="True"
                    FillBehavior="Stop">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetProperty="Opacity"
                    To="{StaticResource AccentDotPulseOpacityMin}"
                    Duration="0:0:1.6"
                    RepeatBehavior="Forever"
                    AutoReverse="True"
                    FillBehavior="Stop">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Style.Resources>
        <Style.Triggers>
