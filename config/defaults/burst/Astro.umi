    "description": "Astro Burst Profile (Default)"
  },
  "name": "Astro",
  "description": "Langzeitbelichtungen und Astro-Stacking",
  "priority": 20,
  "match_conditions": {
    "operator": "OR",
    "groups": [
      {
        "operator": "AND",
        "conditions": [
          { "field": "ExposureTime", "operator": ">=", "value": 1.0 },
          { "field": "ISO", "operator": ">=", "value": 800 }
        ]
      },
      {
        "operator": "AND",
        "conditions": [
          { "field": "ExposureMode", "operator": "==", "value": 6 },
          { "field": "ExposureTime", "operator": ">=", "value": 8.0 }
        ]
      }
    ]
  },
  "grouping": {
    "max_gap_seconds": 90.0,
    "min_count": 10,
    "adaptive_threshold": false
  }
}
